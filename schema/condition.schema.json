{
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/condition.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {
    "description": "A condition matcher type registered by a custom ConditionMatcherFactory."
  },
  "definitions": {
    "allConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "authenticatedConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "boolConditionMatcher": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "and": {
          "description": "Every condition must match.",
          "items": {
            "$ref": "#"
          },
          "type": "array"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "or": {
          "description": "When not empty, one condition must match.",
          "items": {
            "$ref": "#"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "containsConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "ignoreCase": {
          "default": false,
          "type": "boolean"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "examples": [
            "GET",
            "10.0.0.1",
            "admin"
          ],
          "type": "string"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "type": "object"
    },
    "endsWithConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "ignoreCase": {
          "default": false,
          "type": "boolean"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "examples": [
            "GET",
            "10.0.0.1",
            "admin"
          ],
          "type": "string"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "type": "object"
    },
    "eqConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "ignoreCase": {
          "default": false,
          "type": "boolean"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "description": "The value, which may hold #{...} templates.",
          "examples": [
            "admin",
            "#{principal.id}"
          ],
          "type": "string"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "type": "object"
    },
    "inConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "items": {
            "examples": [
              "GET",
              "POST",
              "admin"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "type": "object"
    },
    "inRoleConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "value": {
          "examples": [
            "admin",
            "admin@team-a"
          ],
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "inTenantConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "value": {
          "$ref": "#/definitions/tenantType"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "ognlConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "examples": [
            "true"
          ],
          "type": "string"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        }
      },
      "required": [
        "expression"
      ],
      "type": "object"
    },
    "partValue": {
      "description": "A request or context part. `request.path.var.<name>` reads a variable the statement's own path action captures.",
      "examples": [
        "request.path",
        "request.method",
        "request.appId",
        "request.spaceId",
        "request.deviceId",
        "request.remoteIp",
        "request.origin",
        "request.origin.host",
        "request.referer",
        "request.referer.host",
        "request.header.cosec-app-id",
        "request.attributes.ipRegion",
        "context.tenantId",
        "context.principal.id",
        "context.principal.attributes.department",
        "resource.ownerId"
      ],
      "pattern": "^(request\\.(path|method|appId|spaceId|deviceId|remoteIp|origin|origin\\.host|referer|referer\\.host)|context\\.(tenantId|principal\\.id)|(request\\.header\\.|request\\.attributes\\.|resource\\.|context\\.principal\\.attributes\\.|request\\.path\\.var\\.).+)$",
      "type": "string"
    },
    "pathConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "options": {
          "$ref": "definitions.schema.json#/definitions/pathOptions"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "pattern": {
          "examples": [
            "/orders/**",
            "/orders/{id}",
            "/health"
          ],
          "pattern": "^(?!.*[^/].*/(\\*\\*|\\{\\*[^/]*\\})/)",
          "type": "string"
        }
      },
      "required": [
        "part",
        "pattern"
      ],
      "type": "object"
    },
    "regularConditionMatcher": {
      "additionalProperties": false,
      "description": "Matches the part against a case-insensitive regular expression.",
      "properties": {
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "pattern": {
          "examples": [
            "^/orders/\\d+$",
            "^10\\."
          ],
          "format": "regex",
          "type": "string"
        },
        "timeout": {
          "default": 1000,
          "description": "The time budget of one match in milliseconds.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "part",
        "pattern"
      ],
      "type": "object"
    },
    "spelConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "examples": [
            "true"
          ],
          "type": "string"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        }
      },
      "required": [
        "expression"
      ],
      "type": "object"
    },
    "startsWithConditionMatcher": {
      "additionalProperties": false,
      "properties": {
        "ignoreCase": {
          "default": false,
          "type": "boolean"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "examples": [
            "GET",
            "10.0.0.1",
            "admin"
          ],
          "type": "string"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "type": "object"
    },
    "tenantType": {
      "enum": [
        "default",
        "user",
        "platform"
      ],
      "type": "string"
    },
    "timeConditionMatcher": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "notBefore"
          ]
        },
        {
          "required": [
            "notAfter"
          ]
        },
        {
          "required": [
            "daysOfWeek"
          ]
        },
        {
          "required": [
            "from"
          ]
        }
      ],
      "dependencies": {
        "from": [
          "to"
        ],
        "to": [
          "from"
        ]
      },
      "description": "Matches inside a validity period and, optionally, a recurring daily window [from, to).",
      "properties": {
        "daysOfWeek": {
          "items": {
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN",
              "MONDAY",
              "TUESDAY",
              "WEDNESDAY",
              "THURSDAY",
              "FRIDAY",
              "SATURDAY",
              "SUNDAY"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "from": {
          "examples": [
            "09:00",
            "22:00"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?$",
          "type": "string"
        },
        "negate": {
          "default": false,
          "description": "Inverts the match.",
          "type": "boolean"
        },
        "notAfter": {
          "description": "ISO date-time, exclusive; without an offset it is read in zone.",
          "examples": [
            "2100-01-01T00:00:00Z",
            "2100-01-01T08:00:00+08:00"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?(Z|[+-]((0\\d|1[0-7]):[0-5]\\d|18:00))?$",
          "type": "string"
        },
        "notBefore": {
          "description": "ISO date-time; without an offset it is read in zone.",
          "examples": [
            "2020-01-01T00:00:00Z",
            "2020-01-01T08:00:00"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?(Z|[+-]((0\\d|1[0-7]):[0-5]\\d|18:00))?$",
          "type": "string"
        },
        "to": {
          "examples": [
            "18:00",
            "06:00:00"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?$",
          "type": "string"
        },
        "zone": {
          "default": "UTC",
          "description": "Time zone id.",
          "examples": [
            "UTC",
            "Asia/Shanghai"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "description": "An object naming exactly one condition matcher type. Passing this schema is necessary, not sufficient: the compiler also checks what JSON Schema cannot express, such as unique ids, time zones and expression syntax, so compile or load the document too.",
  "maxProperties": 1,
  "minProperties": 1,
  "properties": {
    "all": {
      "$ref": "#/definitions/allConditionMatcher"
    },
    "authenticated": {
      "$ref": "#/definitions/authenticatedConditionMatcher"
    },
    "bool": {
      "$ref": "#/definitions/boolConditionMatcher"
    },
    "contains": {
      "$ref": "#/definitions/containsConditionMatcher"
    },
    "endsWith": {
      "$ref": "#/definitions/endsWithConditionMatcher"
    },
    "eq": {
      "$ref": "#/definitions/eqConditionMatcher"
    },
    "in": {
      "$ref": "#/definitions/inConditionMatcher"
    },
    "inRole": {
      "$ref": "#/definitions/inRoleConditionMatcher"
    },
    "inTenant": {
      "$ref": "#/definitions/inTenantConditionMatcher"
    },
    "ognl": {
      "$ref": "#/definitions/ognlConditionMatcher"
    },
    "path": {
      "$ref": "#/definitions/pathConditionMatcher"
    },
    "regular": {
      "$ref": "#/definitions/regularConditionMatcher"
    },
    "spel": {
      "$ref": "#/definitions/spelConditionMatcher"
    },
    "startsWith": {
      "$ref": "#/definitions/startsWithConditionMatcher"
    },
    "time": {
      "$ref": "#/definitions/timeConditionMatcher"
    }
  },
  "title": "CoSec Condition Matcher Schema",
  "type": "object"
}
