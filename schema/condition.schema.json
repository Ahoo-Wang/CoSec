{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/condition.schema.json",
  "title": "CoSec Condition Matcher Schema",
  "type": "object",
  "properties": {
    "bool": {
      "$ref": "#/definitions/boolConditionMatcher"
    },
    "all": {
      "$ref": "#/definitions/allConditionMatcher"
    },
    "authenticated": {
      "$ref": "#/definitions/authenticatedConditionMatcher"
    },
    "inTenant": {
      "$ref": "#/definitions/inTenantConditionMatcher"
    },
    "inRole": {
      "$ref": "#/definitions/inRoleConditionMatcher"
    },
    "path": {
      "$ref": "#/definitions/pathConditionMatcher"
    },
    "ognl": {
      "$ref": "#/definitions/ognlConditionMatcher"
    },
    "spel": {
      "$ref": "#/definitions/spelConditionMatcher"
    },
    "contains": {
      "$ref": "#/definitions/containsConditionMatcher"
    },
    "endsWith": {
      "$ref": "#/definitions/endsWithConditionMatcher"
    },
    "startsWith": {
      "$ref": "#/definitions/startsWithConditionMatcher"
    },
    "eq": {
      "$ref": "#/definitions/eqConditionMatcher"
    },
    "in": {
      "$ref": "#/definitions/inConditionMatcher"
    },
    "regular": {
      "$ref": "#/definitions/regularConditionMatcher"
    },
    "time": {
      "$ref": "#/definitions/timeConditionMatcher"
    }
  },
  "maxProperties": 1,
  "definitions": {
    "tenantType": {
      "enum": [
        "default",
        "user",
        "platform"
      ]
    },
    "part": {
      "enum": [
        "request.path",
        "request.method",
        "request.appId",
        "request.spaceId",
        "request.deviceId",
        "request.remoteIp",
        "request.origin",
        "request.origin.host",
        "request.referer",
        "request.referer.host",
        "request.header.",
        "request.header.cosec-app-id",
        "request.attributes.",
        "request.attributes.ipRegion",
        "request.path.var.",
        "context.tenantId",
        "context.principal.id",
        "context.principal.attributes.",
        "resource."
      ]
    },
    "partValue": {
      "anyOf": [
        {
          "$ref": "#/definitions/part"
        },
        {
          "type": "string"
        }
      ]
    },
    "allConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "authenticatedConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "inTenantConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "value": {
          "$ref": "#/definitions/tenantType"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "inRoleConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "ognlConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "expression": {
          "type": "string"
        }
      },
      "required": [
        "expression"
      ],
      "additionalProperties": false
    },
    "spelConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "expression": {
          "type": "string"
        }
      },
      "required": [
        "expression"
      ],
      "additionalProperties": false
    },
    "containsConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "type": "string"
        },
        "ignoreCase": {
          "type": "boolean"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "additionalProperties": false
    },
    "endsWithConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "type": "string"
        },
        "ignoreCase": {
          "type": "boolean"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "additionalProperties": false
    },
    "startsWithConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "type": "string"
        },
        "ignoreCase": {
          "type": "boolean"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "additionalProperties": false
    },
    "eqConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "type": "string"
        },
        "ignoreCase": {
          "type": "boolean"
        }
      },
      "required": [
        "part",
        "value"
      ],
      "additionalProperties": false
    },
    "inConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "part",
        "value"
      ],
      "additionalProperties": false
    },
    "regularConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "pattern": {
          "type": "string",
          "format": "regex"
        }
      },
      "required": [
        "part",
        "pattern"
      ],
      "additionalProperties": false
    },
    "pathConditionMatcher": {
      "type": "object",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "part": {
          "$ref": "#/definitions/partValue"
        },
        "pattern": {
          "type": "string"
        },
        "options": {
          "$ref": "definitions.schema.json#/definitions/pathOptions"
        }
      },
      "required": [
        "part",
        "pattern"
      ],
      "additionalProperties": false
    },
    "boolConditionMatcher": {
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "and": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        },
        "or": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "timeConditionMatcher": {
      "type": "object",
      "description": "Matches inside a validity period and, optionally, a recurring daily window. At least one of notBefore, notAfter, daysOfWeek or from/to is required.",
      "properties": {
        "negate": {
          "type": "boolean"
        },
        "notBefore": {
          "type": "string",
          "description": "ISO date-time; without an offset it is read in zone."
        },
        "notAfter": {
          "type": "string",
          "description": "ISO date-time, exclusive; without an offset it is read in zone."
        },
        "zone": {
          "type": "string",
          "description": "Time zone id, default UTC.",
          "default": "UTC"
        },
        "daysOfWeek": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?i)(MON|TUE|WED|THU|FRI|SAT|SUN|MONDAY|TUESDAY|WEDNESDAY|THURSDAY|FRIDAY|SATURDAY|SUNDAY)$"
          }
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
        }
      },
      "dependencies": {
        "from": [
          "to"
        ],
        "to": [
          "from"
        ]
      },
      "additionalProperties": false
    }
  }
}
