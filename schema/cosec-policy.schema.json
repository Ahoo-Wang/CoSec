{
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/cosec-policy.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "policyType": {
      "enum": [
        "global",
        "system",
        "custom"
      ],
      "type": "string"
    },
    "statement": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "action.schema.json"
        },
        "condition": {
          "$ref": "condition.schema.json"
        },
        "effect": {
          "$ref": "definitions.schema.json#/definitions/effect",
          "default": "allow"
        },
        "name": {
          "examples": [
            "read-orders"
          ],
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  },
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows; the parser ignores it.",
      "examples": [
        "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/cosec-policy.schema.json"
      ],
      "type": "string"
    },
    "category": {
      "description": "The category of the policy",
      "examples": [
        "order"
      ],
      "type": "string"
    },
    "condition": {
      "$ref": "condition.schema.json",
      "description": "The condition of the policy"
    },
    "description": {
      "description": "The description of the policy",
      "examples": [
        "Order access"
      ],
      "type": "string"
    },
    "id": {
      "description": "The id of the policy",
      "examples": [
        "orders"
      ],
      "type": "string"
    },
    "name": {
      "description": "The name of the policy",
      "examples": [
        "Orders"
      ],
      "type": "string"
    },
    "statements": {
      "items": {
        "$ref": "#/definitions/statement"
      },
      "type": "array"
    },
    "tenantId": {
      "description": "The tenantId of the policy",
      "examples": [
        "(platform)",
        "tenant-a"
      ],
      "type": "string"
    },
    "type": {
      "$ref": "#/definitions/policyType",
      "description": "The type of the policy"
    }
  },
  "required": [
    "id",
    "name",
    "tenantId",
    "type"
  ],
  "title": "CoSec Policy Schema",
  "type": "object"
}
