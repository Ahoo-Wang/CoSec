{
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/cosec-app-permission.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "permission": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "action.schema.json"
        },
        "condition": {
          "$ref": "condition.schema.json"
        },
        "description": {
          "description": "The description of the permission",
          "examples": [
            "Ship orders"
          ],
          "type": "string"
        },
        "effect": {
          "$ref": "definitions.schema.json#/definitions/effect",
          "default": "allow"
        },
        "id": {
          "description": "The id of the permission",
          "examples": [
            "manage.order.ship"
          ],
          "type": "string"
        },
        "name": {
          "examples": [
            "read-orders"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "action"
      ],
      "type": "object"
    },
    "permissionGroup": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "The description of the permission group",
          "examples": [
            "Orders"
          ],
          "type": "string"
        },
        "name": {
          "description": "The name of the permission group",
          "examples": [
            "order"
          ],
          "type": "string"
        },
        "permissions": {
          "items": {
            "$ref": "#/definitions/permission"
          },
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows; the parser ignores it.",
      "examples": [
        "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/cosec-app-permission.schema.json"
      ],
      "type": "string"
    },
    "condition": {
      "$ref": "condition.schema.json",
      "description": "The condition of the app permission"
    },
    "groups": {
      "items": {
        "$ref": "#/definitions/permissionGroup"
      },
      "type": "array"
    },
    "id": {
      "description": "The id of the app",
      "examples": [
        "manage"
      ],
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "CoSec App Permission Schema",
  "type": "object"
}
