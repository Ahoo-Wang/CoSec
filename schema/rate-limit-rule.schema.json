{
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/rate-limit-rule.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "$ref": "#/definitions/rule"
    },
    {
      "items": {
        "$ref": "#/definitions/rule"
      },
      "type": "array"
    }
  ],
  "definitions": {
    "rule": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "description": "The JSON Schema this file follows; the parser ignores it.",
          "examples": [
            "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/rate-limit-rule.schema.json"
          ],
          "type": "string"
        },
        "action": {
          "$ref": "action.schema.json"
        },
        "condition": {
          "$ref": "condition.schema.json"
        },
        "id": {
          "description": "Names the quota; counters belong to the id. Must be unique.",
          "examples": [
            "login",
            "api.per-user"
          ],
          "pattern": "^[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "key": {
          "$ref": "condition.schema.json#/definitions/partValue",
          "description": "The part that splits the quota into one bucket per value. Omit to share one bucket."
        },
        "permitsPerSecond": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "strictFailure": {
          "default": false,
          "description": "Whether a backend failure rejects the request (true) or skips the rule (false).",
          "type": "boolean"
        },
        "windowSeconds": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "action",
        "permitsPerSecond"
      ],
      "type": "object"
    }
  },
  "description": "A rate limit rules file: one rule or an array of rules.",
  "title": "CoSec Rate Limit Rule Schema"
}
