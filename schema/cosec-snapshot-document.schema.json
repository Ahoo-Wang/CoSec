{
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/cosec-snapshot-document.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "$ref": "#/definitions/platformDocument"
    },
    {
      "$ref": "#/definitions/tenantDocument"
    },
    {
      "$ref": "#/definitions/appDocument"
    }
  ],
  "definitions": {
    "actionPattern": {
      "description": "`service:verb`, `service:*` or `*` (RFC 0005 §5.1).",
      "examples": [
        "*",
        "order:*",
        "order:read",
        "http:GET",
        "http:*"
      ],
      "pattern": "^(\\*|[^:*\\s\\x00-\\x1F\\x7F-\\x9F]+:(\\*|[^:*\\s\\x00-\\x1F\\x7F-\\x9F]+))$",
      "type": "string"
    },
    "appDocument": {
      "additionalProperties": false,
      "description": "An app document: its catalog, its permission policies `perm:<app>/<permission>` and role bindings.",
      "properties": {
        "bindings": {
          "items": {
            "$ref": "cosec-binding.schema.json"
          },
          "type": "array"
        },
        "catalog": {
          "$ref": "cosec-catalog.schema.json"
        },
        "policies": {
          "items": {
            "$ref": "#/definitions/policy"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/definitions/provenance",
          "description": "Where the revision came from (RFC 0007 §5.3); the control plane writes it on every publish."
        },
        "publishedAt": {
          "examples": [
            "2026-10-26T00:00:00Z"
          ],
          "format": "date-time",
          "type": "string"
        },
        "rateLimits": {
          "description": "Rate limit rules, in order (RFC 0006 §8.1): what a permitted request spends.",
          "items": {
            "$ref": "#/definitions/rateLimit"
          },
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "schema": {
          "const": 2,
          "description": "The document format version.",
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "revision",
        "publishedAt"
      ],
      "type": "object"
    },
    "attributeOperand": {
      "additionalProperties": false,
      "properties": {
        "attr": {
          "description": "An attribute of the catalog (RFC 0005 §3.2), or an external attribute (`ext.<provider>.<name>`) a registered AttributeProvider declares (RFC 0006 §5.4.1).",
          "examples": [
            "subject.id",
            "subject.authenticated",
            "scope.app",
            "scope.space",
            "scope.roles",
            "resource.var.id",
            "resource.type",
            "environment.ip",
            "http.header.x-trace",
            "http.origin.host.labels",
            "request.attributes.region"
          ],
          "type": "string"
        }
      },
      "required": [
        "attr"
      ],
      "type": "object"
    },
    "condition": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "eq": {
              "additionalItems": false,
              "items": [
                {
                  "description": "An attribute of the catalog (RFC 0005 §3.2), or an external attribute (`ext.<provider>.<name>`) a registered AttributeProvider declares (RFC 0006 §5.4.1).",
                  "examples": [
                    "subject.id",
                    "subject.authenticated",
                    "scope.app",
                    "scope.space",
                    "scope.roles",
                    "resource.var.id",
                    "resource.type",
                    "environment.ip",
                    "http.header.x-trace",
                    "http.origin.host.labels",
                    "request.attributes.region"
                  ],
                  "type": "string"
                },
                {
                  "anyOf": [
                    {
                      "examples": [
                        "admin",
                        "order",
                        "10.0.0.0/8"
                      ],
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "$ref": "#/definitions/attributeOperand"
                    }
                  ]
                }
              ],
              "minItems": 2,
              "type": "array"
            },
            "ignoreCase": {
              "default": false,
              "description": "ASCII case folding.",
              "type": "boolean"
            }
          },
          "required": [
            "eq"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`[attribute, [literals]]`: the value is one of them; `[literal, set attribute]`: the set holds it.",
          "properties": {
            "in": {
              "additionalItems": false,
              "items": [
                {
                  "examples": [
                    "subject.id",
                    "subject.authenticated",
                    "scope.app",
                    "scope.space",
                    "scope.roles",
                    "resource.var.id",
                    "resource.type",
                    "environment.ip",
                    "http.header.x-trace",
                    "http.origin.host.labels",
                    "request.attributes.region",
                    "admin"
                  ],
                  "type": "string"
                },
                {
                  "anyOf": [
                    {
                      "items": {
                        "anyOf": [
                          {
                            "examples": [
                              "admin",
                              "order",
                              "10.0.0.0/8"
                            ],
                            "type": "string"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    {
                      "description": "An attribute of the catalog (RFC 0005 §3.2), or an external attribute (`ext.<provider>.<name>`) a registered AttributeProvider declares (RFC 0006 §5.4.1).",
                      "examples": [
                        "subject.id",
                        "subject.authenticated",
                        "scope.app",
                        "scope.space",
                        "scope.roles",
                        "resource.var.id",
                        "resource.type",
                        "environment.ip",
                        "http.header.x-trace",
                        "http.origin.host.labels",
                        "request.attributes.region"
                      ],
                      "type": "string"
                    }
                  ]
                }
              ],
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "in"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ignoreCase": {
              "default": false,
              "description": "ASCII case folding.",
              "type": "boolean"
            },
            "prefix": {
              "additionalItems": false,
              "items": [
                {
                  "description": "An attribute of the catalog (RFC 0005 §3.2), or an external attribute (`ext.<provider>.<name>`) a registered AttributeProvider declares (RFC 0006 §5.4.1).",
                  "examples": [
                    "subject.id",
                    "subject.authenticated",
                    "scope.app",
                    "scope.space",
                    "scope.roles",
                    "resource.var.id",
                    "resource.type",
                    "environment.ip",
                    "http.header.x-trace",
                    "http.origin.host.labels",
                    "request.attributes.region"
                  ],
                  "type": "string"
                },
                {
                  "examples": [
                    "ad",
                    "com.example"
                  ],
                  "type": "string"
                }
              ],
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "prefix"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cidr": {
              "additionalItems": false,
              "items": [
                {
                  "description": "An attribute of the catalog (RFC 0005 §3.2), or an external attribute (`ext.<provider>.<name>`) a registered AttributeProvider declares (RFC 0006 §5.4.1).",
                  "examples": [
                    "subject.id",
                    "subject.authenticated",
                    "scope.app",
                    "scope.space",
                    "scope.roles",
                    "resource.var.id",
                    "resource.type",
                    "environment.ip",
                    "http.header.x-trace",
                    "http.origin.host.labels",
                    "request.attributes.region"
                  ],
                  "type": "string"
                },
                {
                  "items": {
                    "examples": [
                      "10.0.0.0/8",
                      "2001:db8::/32"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                }
              ],
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "cidr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "time": {
              "$ref": "#/definitions/time"
            }
          },
          "required": [
            "time"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exists": {
              "description": "An attribute of the catalog (RFC 0005 §3.2), or an external attribute (`ext.<provider>.<name>`) a registered AttributeProvider declares (RFC 0006 §5.4.1).",
              "examples": [
                "subject.id",
                "subject.authenticated",
                "scope.app",
                "scope.space",
                "scope.roles",
                "resource.var.id",
                "resource.type",
                "environment.ip",
                "http.header.x-trace",
                "http.origin.host.labels",
                "request.attributes.region"
              ],
              "type": "string"
            }
          },
          "required": [
            "exists"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "and": {
              "items": {
                "$ref": "#/definitions/condition"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "and"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "or": {
              "items": {
                "$ref": "#/definitions/condition"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "or"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": [
            "not"
          ],
          "type": "object"
        }
      ],
      "description": "A condition (RFC 0005 §3.1): one operator."
    },
    "platformBinding": {
      "additionalProperties": false,
      "description": "A binding of the platform document: a principal names its tenant.",
      "properties": {
        "app": {
          "description": "An id, or `*` for any.",
          "examples": [
            "*",
            "order-service"
          ],
          "minLength": 1,
          "type": "string"
        },
        "breakGlass": {
          "default": false,
          "description": "A break-glass binding: platform document, platform-tenant principal, expiresAt.",
          "type": "boolean"
        },
        "expiresAt": {
          "description": "When the binding stops applying. Required for break-glass bindings.",
          "examples": [
            "2026-12-31T00:00:00Z"
          ],
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "examples": [
            "g:deny-ip",
            "r:editor:read"
          ],
          "type": "string"
        },
        "policy": {
          "examples": [
            "deny-ip",
            "perm:order-service/read",
            "cosec:root"
          ],
          "type": "string"
        },
        "space": {
          "description": "An id, or `*` for any.",
          "examples": [
            "*",
            "",
            "team-a"
          ],
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "description": "Anyone, anonymous principals included.",
              "enum": [
                "*"
              ],
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "principal": {
                  "examples": [
                    "cosec",
                    "svc-batch"
                  ],
                  "type": "string"
                },
                "tenant": {
                  "examples": [
                    "(platform)",
                    "acme"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "principal",
                "tenant"
              ],
              "type": "object"
            },
            {
              "$ref": "cosec-binding.schema.json#/definitions/roleSubject"
            }
          ]
        }
      },
      "required": [
        "id",
        "subject",
        "app",
        "space",
        "policy"
      ],
      "type": "object"
    },
    "platformDocument": {
      "additionalProperties": false,
      "description": "The platform document (RFC 0004 §7.1) with what only it holds: boundaries, and the limits and attributes every document compiles against (RFC 0007 §7.6, §3.1 N3). A principal names its tenant.",
      "properties": {
        "attributes": {
          "description": "The external attributes documents may read (RFC 0006 §5.4.1), with their types; paths unique. Platform only.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "examples": [
                  "ext.geo.region",
                  "ext.risk.score"
                ],
                "pattern": "^ext\\.[^.]+\\..+$",
                "type": "string"
              },
              "type": {
                "enum": [
                  "string",
                  "bool",
                  "stringSet",
                  "ip"
                ],
                "type": "string"
              }
            },
            "required": [
              "path",
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "bindings": {
          "items": {
            "$ref": "#/definitions/platformBinding"
          },
          "type": "array"
        },
        "boundaries": {
          "additionalProperties": false,
          "properties": {
            "default": {
              "description": "The boundary policy that holds every tenant that names none (RFC 0007 §7.6).",
              "examples": [
                "boundary-standard"
              ],
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "limits": {
          "additionalProperties": false,
          "description": "The condition limits of every document (RFC 0005 §3.5); absent ones are the defaults. Platform only.",
          "properties": {
            "maxCidrBlocks": {
              "default": 256,
              "description": "Blocks of one `cidr`.",
              "minimum": 1,
              "type": "integer"
            },
            "maxCost": {
              "default": 256,
              "description": "Weighted cost of one statement's condition.",
              "minimum": 1,
              "type": "integer"
            },
            "maxDepth": {
              "default": 8,
              "description": "Depth of one condition.",
              "minimum": 1,
              "type": "integer"
            },
            "maxInValues": {
              "default": 1024,
              "description": "Literals of one `in`.",
              "minimum": 1,
              "type": "integer"
            },
            "maxLiteralBytes": {
              "default": 1024,
              "description": "UTF-8 bytes of one literal.",
              "minimum": 1,
              "type": "integer"
            },
            "maxNodes": {
              "default": 64,
              "description": "Nodes of one condition.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "policies": {
          "items": {
            "$ref": "#/definitions/policy"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/definitions/provenance",
          "description": "Where the revision came from (RFC 0007 §5.3); the control plane writes it on every publish."
        },
        "publishedAt": {
          "examples": [
            "2026-10-26T00:00:00Z"
          ],
          "format": "date-time",
          "type": "string"
        },
        "rateLimits": {
          "description": "Rate limit rules, in order (RFC 0006 §8.1): what a permitted request spends.",
          "items": {
            "$ref": "#/definitions/rateLimit"
          },
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "schema": {
          "const": 2,
          "description": "The document format version.",
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "revision",
        "publishedAt"
      ],
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "attachable": {
          "default": false,
          "description": "Whether a principal may attach it.",
          "type": "boolean"
        },
        "boundary": {
          "default": false,
          "description": "A platform boundary (RFC 0007 §7.6): in the platform document only, at most 64 ALLOW statements, never bound or attached.",
          "type": "boolean"
        },
        "condition": {
          "$ref": "#/definitions/condition",
          "description": "The policy condition; it cannot read captured variables."
        },
        "id": {
          "examples": [
            "deny-ip",
            "perm:order-service/read"
          ],
          "type": "string"
        },
        "statements": {
          "items": {
            "$ref": "#/definitions/statement"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "statements"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "description": "The control plane's record of how a revision was published; it decides nothing.",
      "properties": {
        "approvedBy": {
          "description": "Absent or empty without an approval.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "principal": {
                "examples": [
                  "alice",
                  "ops-1"
                ],
                "minLength": 1,
                "type": "string"
              },
              "tenant": {
                "examples": [
                  "acme",
                  "(platform)"
                ],
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "tenant",
              "principal"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "change": {
          "examples": [
            "0QH8K3"
          ],
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "PUBLISH",
            "ROLLBACK",
            "BREAK_GLASS",
            "EXPIRE",
            "MIGRATE",
            "BOOTSTRAP"
          ],
          "type": "string"
        },
        "parent": {
          "additionalProperties": false,
          "description": "The head this revision replaced; absent for the first revision.",
          "properties": {
            "digest": {
              "description": "The store's digest of the parent: the address of its revision record.",
              "examples": [
                "9f2c0b1e6a6d1f2c3b4a5d6e7f8091a2b3c4d5e6"
              ],
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "revision",
            "digest"
          ],
          "type": "object"
        },
        "publishedBy": {
          "additionalProperties": false,
          "properties": {
            "principal": {
              "examples": [
                "alice",
                "ops-1"
              ],
              "minLength": 1,
              "type": "string"
            },
            "tenant": {
              "examples": [
                "acme",
                "(platform)"
              ],
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "tenant",
            "principal"
          ],
          "type": "object"
        },
        "shadow": {
          "additionalProperties": false,
          "properties": {
            "skipped": {
              "type": "boolean"
            },
            "window": {
              "examples": [
                "0QH8M1"
              ],
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "skipped"
          ],
          "type": "object"
        }
      },
      "required": [
        "change",
        "kind",
        "publishedBy"
      ],
      "type": "object"
    },
    "rateLimit": {
      "additionalProperties": false,
      "description": "A rate limit rule (RFC 0006 §8): a permitted request it matches spends one permit; an exhausted one is 429.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/definitions/actionPattern"
            },
            {
              "items": {
                "$ref": "#/definitions/actionPattern"
              },
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "condition": {
          "$ref": "#/definitions/condition",
          "description": "Which requests count; matched as a DENY is."
        },
        "id": {
          "description": "Unique in its document. An app's or tenant's rule counts in buckets of its own.",
          "examples": [
            "login-per-ip",
            "orders.api"
          ],
          "pattern": "^[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "key": {
          "description": "The text or address attribute whose value names the bucket. Absent: one bucket; an absent value: the empty bucket.",
          "examples": [
            "environment.ip",
            "subject.id",
            "resource.var.orderId"
          ],
          "type": "string"
        },
        "onMissing": {
          "default": "indeterminate",
          "description": "An external attribute that cannot be fetched: indeterminate leaves it to strictFailure; nomatch skips the rule (platform document only).",
          "enum": [
            "indeterminate",
            "nomatch"
          ],
          "type": "string"
        },
        "permitsPerSecond": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/definitions/resource"
            },
            {
              "items": {
                "$ref": "#/definitions/resource"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Absent: any resource."
        },
        "strictFailure": {
          "default": false,
          "description": "Whether a rate limiter that cannot count refuses the request (503) instead of skipping the rule.",
          "type": "boolean"
        },
        "windowSeconds": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "action",
        "permitsPerSecond"
      ],
      "type": "object"
    },
    "resource": {
      "anyOf": [
        {
          "$ref": "#/definitions/resourcePattern"
        },
        {
          "additionalProperties": false,
          "description": "An `http:path:` pattern with options.",
          "properties": {
            "caseSensitive": {
              "default": true,
              "type": "boolean"
            },
            "decodeAndParseSegments": {
              "default": true,
              "type": "boolean"
            },
            "pattern": {
              "$ref": "#/definitions/resourcePattern"
            }
          },
          "required": [
            "pattern"
          ],
          "type": "object"
        }
      ]
    },
    "resourcePattern": {
      "description": "`type/segment/...` or `http:path:<pattern>` (RFC 0005 §5.1, §5.2). A DENY cannot name a bare type.",
      "examples": [
        "order/{orderId}",
        "order/**",
        "http:path:/orders/{id}",
        "http:path:/admin/**"
      ],
      "pattern": "^(http:path:(?!.*[^/].*/(\\*\\*|\\{\\*[^/]*\\})/)([^{}]|\\{\\*?[^/{}*?:\\s\\d-][^/{}*?:\\s]*\\})+|(?!http(/|$))[^/*?{}:\\s\\x00-\\x1F\\x7F-\\x9F]+(/(\\*|\\{[^/{}*?:\\s\\d-][^/{}*?:\\s]*\\}|[^/*?{}\\s\\x00-\\x1F\\x7F-\\x9F]+))*(/\\*\\*)?)$",
      "type": "string"
    },
    "statement": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/definitions/actionPattern"
            },
            {
              "items": {
                "$ref": "#/definitions/actionPattern"
              },
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "effect": {
          "$ref": "definitions.schema.json#/definitions/effect"
        },
        "name": {
          "examples": [
            "read-orders"
          ],
          "type": "string"
        },
        "onMissing": {
          "default": "indeterminate",
          "description": "What an external attribute (ext.*) the condition reads that cannot be fetched means (RFC 0006 §5.4.3). Only for a condition that reads one; a DENY that says nomatch needs onMissingConfirmed.",
          "enum": [
            "indeterminate",
            "nomatch"
          ],
          "type": "string"
        },
        "onMissingConfirmed": {
          "additionalProperties": false,
          "description": "Who confirmed that this DENY with onMissing: nomatch may lapse while its attributes cannot be fetched, and in which change (RFC 0007 §9.5). The control plane writes it.",
          "properties": {
            "by": {
              "additionalProperties": false,
              "properties": {
                "principal": {
                  "examples": [
                    "alice",
                    "ops-1"
                  ],
                  "minLength": 1,
                  "type": "string"
                },
                "tenant": {
                  "examples": [
                    "acme",
                    "(platform)"
                  ],
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "tenant",
                "principal"
              ],
              "type": "object"
            },
            "change": {
              "examples": [
                "0QH8K3"
              ],
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "by",
            "change"
          ],
          "type": "object"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "#/definitions/resource"
            },
            {
              "items": {
                "$ref": "#/definitions/resource"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Absent: any resource."
        }
      },
      "required": [
        "effect",
        "action"
      ],
      "type": "object"
    },
    "tenantDocument": {
      "additionalProperties": false,
      "description": "A tenant document (RFC 0004 §7.1): the tenant's own policies and bindings.",
      "properties": {
        "bindings": {
          "items": {
            "$ref": "cosec-binding.schema.json"
          },
          "type": "array"
        },
        "boundary": {
          "description": "The platform boundary policy that holds this tenant instead of the default; only the platform writes it.",
          "examples": [
            "boundary-restricted"
          ],
          "minLength": 1,
          "type": "string"
        },
        "policies": {
          "items": {
            "$ref": "#/definitions/policy"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/definitions/provenance",
          "description": "Where the revision came from (RFC 0007 §5.3); the control plane writes it on every publish."
        },
        "publishedAt": {
          "examples": [
            "2026-10-26T00:00:00Z"
          ],
          "format": "date-time",
          "type": "string"
        },
        "rateLimits": {
          "description": "Rate limit rules, in order (RFC 0006 §8.1): what a permitted request spends.",
          "items": {
            "$ref": "#/definitions/rateLimit"
          },
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "schema": {
          "const": 2,
          "description": "The document format version.",
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "revision",
        "publishedAt"
      ],
      "type": "object"
    },
    "time": {
      "additionalProperties": false,
      "properties": {
        "daysOfWeek": {
          "items": {
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "from": {
          "examples": [
            "09:00"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?$",
          "type": "string"
        },
        "notAfter": {
          "description": "An ISO date-time; without an offset it is read in zone.",
          "examples": [
            "2027-01-01T00:00:00Z",
            "2027-01-01T08:00:00+08:00"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?(Z|[+-]((0\\d|1[0-7]):[0-5]\\d|18:00))?$",
          "type": "string"
        },
        "notBefore": {
          "description": "An ISO date-time; without an offset it is read in zone.",
          "examples": [
            "2026-01-01T00:00:00Z",
            "2026-01-01T08:00:00"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?(Z|[+-]((0\\d|1[0-7]):[0-5]\\d|18:00))?$",
          "type": "string"
        },
        "to": {
          "examples": [
            "18:00"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,9})?)?$",
          "type": "string"
        },
        "zone": {
          "examples": [
            "UTC",
            "Asia/Shanghai"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "description": "The body of a stored snapshot document: a platform, app or tenant document (RFC 0004 §7.1, schema 2). Ids must be unique. Passing this schema is necessary, not sufficient: the compiler also checks what JSON Schema cannot express, such as unique ids, time zones and expression syntax, so compile or load the document too.",
  "title": "CoSec Snapshot Document Schema"
}
