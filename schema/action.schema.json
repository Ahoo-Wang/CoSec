{
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/action.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "examples": [
        "*",
        "/orders/**",
        "/orders/{id}",
        "/users/#{principal.id}/orders",
        "/health"
      ],
      "pattern": "^(?!.*[^/].*/(\\*\\*|\\{\\*[^/]*\\})/)",
      "type": "string"
    },
    {
      "items": {
        "$ref": "#"
      },
      "type": "array",
      "uniqueItems": true
    },
    {
      "additionalProperties": {
        "description": "An action matcher type registered by a custom ActionMatcherFactory."
      },
      "maxProperties": 1,
      "minProperties": 1,
      "properties": {
        "all": {
          "$ref": "#/definitions/allActionMatcher"
        },
        "composite": {
          "$ref": "#/definitions/compositeActionMatcher"
        },
        "path": {
          "$ref": "#/definitions/pathAction"
        }
      },
      "type": "object"
    }
  ],
  "definitions": {
    "allActionMatcher": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/definitions/methodValue"
        }
      },
      "type": "object"
    },
    "compositeActionMatcher": {
      "items": {
        "$ref": "#"
      },
      "minItems": 1,
      "type": "array"
    },
    "method": {
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "TRACE"
      ],
      "type": "string"
    },
    "methodValue": {
      "anyOf": [
        {
          "$ref": "#/definitions/method"
        },
        {
          "items": {
            "$ref": "#/definitions/method"
          },
          "type": "array",
          "uniqueItems": true
        }
      ]
    },
    "pathAction": {
      "anyOf": [
        {
          "examples": [
            "/orders/**",
            "/orders/{id}",
            "/users/#{principal.id}/orders",
            "/health"
          ],
          "pattern": "^(?!.*[^/].*/(\\*\\*|\\{\\*[^/]*\\})/)",
          "type": "string"
        },
        {
          "items": {
            "examples": [
              "/orders/**",
              "/orders/{id}",
              "/users/#{principal.id}/orders",
              "/health"
            ],
            "pattern": "^(?!.*[^/].*/(\\*\\*|\\{\\*[^/]*\\})/)",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        {
          "$ref": "#/definitions/pathActionMatcher"
        }
      ]
    },
    "pathActionMatcher": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/definitions/methodValue"
        },
        "options": {
          "$ref": "definitions.schema.json#/definitions/pathOptions"
        },
        "pattern": {
          "anyOf": [
            {
              "examples": [
                "/orders/**",
                "/orders/{id}",
                "/users/#{principal.id}/orders",
                "/health"
              ],
              "pattern": "^(?!.*[^/].*/(\\*\\*|\\{\\*[^/]*\\})/)",
              "type": "string"
            },
            {
              "items": {
                "examples": [
                  "/orders/**",
                  "/orders/{id}",
                  "/users/#{principal.id}/orders",
                  "/health"
                ],
                "pattern": "^(?!.*[^/].*/(\\*\\*|\\{\\*[^/]*\\})/)",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          ]
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    }
  },
  "description": "What requests a statement applies to: a path pattern (`*` for every request), an array of actions, or an object naming one action matcher type. Passing this schema is necessary, not sufficient: the compiler also checks what JSON Schema cannot express, such as unique ids, time zones and expression syntax, so compile or load the document too.",
  "title": "CoSec Action Matcher Schema"
}
