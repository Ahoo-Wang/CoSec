{
  "$id": "https://raw.githubusercontent.com/Ahoo-Wang/CoSec/refs/heads/main/schema/cosec-catalog.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "group": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "examples": [
            "Orders"
          ],
          "type": "string"
        },
        "name": {
          "examples": [
            "order"
          ],
          "type": "string"
        },
        "permissions": {
          "items": {
            "$ref": "#/definitions/permission"
          },
          "type": "array"
        },
        "spaced": {
          "default": false,
          "description": "Whether a permission written with `action` applies in any space a role holding it applies in; without it, only in the default space (RFC 0012 §4.2).",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "permissions"
      ],
      "type": "object"
    },
    "permission": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "cosec-snapshot-document.schema.json#/definitions/actionPattern"
            },
            {
              "items": {
                "$ref": "cosec-snapshot-document.schema.json#/definitions/actionPattern"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Defines the permission `perm:<app>/<id>` here (RFC 0012 §4): no hand-written policy of that id may exist."
        },
        "description": {
          "examples": [
            "Read orders"
          ],
          "type": "string"
        },
        "id": {
          "examples": [
            "read",
            "ship"
          ],
          "type": "string"
        },
        "name": {
          "examples": [
            "Read"
          ],
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "$ref": "cosec-snapshot-document.schema.json#/definitions/resource"
            },
            {
              "items": {
                "$ref": "cosec-snapshot-document.schema.json#/definitions/resource"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Needs `action`. Absent: any resource."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "description": "An app's permission catalog (RFC 0004 §4.9, RFC 0012 §4): for UIs and generators; an entry with `action` also defines the permission. Passing this schema is necessary, not sufficient: the compiler also checks what JSON Schema cannot express, such as unique ids, time zones and expression syntax, so compile or load the document too.",
  "properties": {
    "groups": {
      "items": {
        "$ref": "#/definitions/group"
      },
      "type": "array"
    }
  },
  "required": [
    "groups"
  ],
  "title": "CoSec Catalog Schema",
  "type": "object"
}
