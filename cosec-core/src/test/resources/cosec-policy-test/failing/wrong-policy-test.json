{
  "name": "wrong",
  "policies": ["classpath:cosec-policy-test/policies/*-policy.json"],
  "cases": [
    {
      "name": "expects a deny that does not exist",
      "principal": { "id": "alice", "policies": ["gone"] },
      "request": { "path": "/orders/42" },
      "expect": { "result": "EXPLICIT_DENY" }
    },
    {
      "name": "passes",
      "principal": { "id": "alice" },
      "request": { "path": "/orders/42" },
      "expect": { "result": "ALLOW" }
    }
  ]
}
