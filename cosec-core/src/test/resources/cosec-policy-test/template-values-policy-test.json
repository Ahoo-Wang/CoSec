{
  "name": "template-values",
  "policies": ["classpath:cosec-policy-test/template-values/*-policy.json"],
  "cases": [
    {
      "name": "users read their own path",
      "principal": { "id": "alice" },
      "request": { "path": "/users/alice/orders" },
      "expect": { "result": "ALLOW", "policyId": "own-path", "statementName": "own" }
    },
    {
      "name": "a wildcard id reaches no other user",
      "principal": { "id": "*" },
      "request": { "path": "/users/victim/orders" },
      "expect": { "result": "EXPLICIT_DENY", "statementName": "no-delete" }
    },
    {
      "name": "a capture id does not escape its own deny",
      "principal": { "id": "{x:[0-9]+}" },
      "request": { "path": "/users/{x:[0-9]+}/delete" },
      "expect": { "result": "EXPLICIT_DENY", "statementName": "no-delete" }
    },
    {
      "name": "an id with a separator reaches no other user",
      "principal": { "id": "a/b" },
      "request": { "path": "/users/a/b/orders" },
      "expect": { "result": "EXPLICIT_DENY", "statementName": "no-delete" }
    }
  ]
}
