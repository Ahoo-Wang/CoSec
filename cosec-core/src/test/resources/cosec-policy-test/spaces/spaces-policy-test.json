{
  "name": "spaces",
  "appPermissions": [
    "classpath:cosec-policy/test-app-permission.json",
    "classpath:cosec-policy-test/spaces/billing-app-permission.json"
  ],
  "appRoles": {
    "manage": { "shipper@team-a": ["manage.order.ship"], "invoicer": ["manage.order.issueInvoice"] }
  },
  "cases": [
    {
      "name": "a role in team-a ships in team-a",
      "principal": { "id": "bob", "roles": ["shipper@team-a"] },
      "request": { "path": "/order/ship", "method": "POST", "appId": "manage", "spaceId": "team-a", "remoteIp": "192.168.1.9" },
      "expect": { "result": "ALLOW", "roleId": "shipper", "permissionId": "manage.order.ship" }
    },
    {
      "name": "a role in team-a does not ship in the default space",
      "principal": { "id": "bob", "roles": ["shipper@team-a"] },
      "request": { "path": "/order/ship", "method": "POST", "appId": "manage", "remoteIp": "192.168.1.9" },
      "expect": { "result": "IMPLICIT_DENY" }
    },
    {
      "name": "the same role in the default space does not reach the team-a grant",
      "principal": { "id": "bob", "roles": ["shipper"] },
      "request": { "path": "/order/ship", "method": "POST", "appId": "manage", "spaceId": "team-a", "remoteIp": "192.168.1.9" },
      "expect": { "result": "IMPLICIT_DENY" }
    },
    {
      "name": "an app grant applies in its app",
      "principal": { "id": "carol", "roles": ["invoicer"] },
      "request": { "path": "/order/issueInvoice", "method": "POST", "appId": "manage", "remoteIp": "192.168.1.9" },
      "expect": { "result": "ALLOW", "roleId": "invoicer", "permissionId": "manage.order.issueInvoice" }
    },
    {
      "name": "an app grant does not apply in another app with the same permission id",
      "principal": { "id": "carol", "roles": ["invoicer"] },
      "request": { "path": "/order/issueInvoice", "method": "POST", "appId": "billing" },
      "expect": { "result": "IMPLICIT_DENY" }
    }
  ]
}
