{
  "name": "cosec-typescript",
  "private": true,
  "description": "pnpm workspace root for CoSec's TypeScript packages (the client and its React hooks)",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "node --test scripts/*.test.mjs && pnpm -r test",
    "lint": "eslint --max-warnings 0 eslint.config.js scripts && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:host": "node scripts/with-host.mjs -- pnpm -r --workspace-concurrency=1 test:host",
    "format:check": "prettier --check .",
    "check:package": "node scripts/package-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  }
}
