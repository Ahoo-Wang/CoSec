+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/SharedRead.kt
@@ -71,7 +71,11 @@ internal class SharedRead<T>(
     @Suppress("TooGenericExceptionCaught")
     private suspend fun loadInto(shared: CompletableDeferred<Read<T>?>): Read<T> {
         try {
-            val read = clock.instant().let { asOf -> Read(load(), asOf) }
+            val read = try {
+                clock.instant().let { asOf -> Read(load(), asOf) }
