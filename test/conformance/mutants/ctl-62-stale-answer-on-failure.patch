# Rule: CTL-62
# Mutant: a shared read that fails answers the last read instead of failing: an outage reads as a propagation (or a document list) that stopped
# Tests: :control:test --tests me.ahoo.cosec.control.lifecycle.PropagationTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/SharedRead.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/SharedRead.kt
index 6185991fc..d5e01fe9a 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/SharedRead.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/SharedRead.kt
@@ -40,7 +40,11 @@ internal class SharedRead<T>(
     private var last: Read<T>? = null
 
     suspend fun read(): Read<T> = fresh() ?: lock.withLock {
-        fresh() ?: clock.instant().let { asOf -> Read(load(), asOf) }.also { last = it }
+        fresh() ?: try {
+            clock.instant().let { asOf -> Read(load(), asOf) }.also { last = it }
+        } catch (e: me.ahoo.cosec.control.store.ControlStoreException) {
+            last ?: throw e
+        }
     }
 
     private fun fresh(): Read<T>? = last?.takeIf { Duration.between(it.asOf, clock.instant()) < maxAge }
