# Rule: CTL-30
# Mutant: the shared question lets a referenced policy change between a policy and a boundary, for the check and the write
# Tests: :control:test --tests me.ahoo.cosec.control.change.BoundaryReferencesTest :conformance:test

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferencedPolicies.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferencedPolicies.kt
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferencedPolicies.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferencedPolicies.kt
@@ -53,7 +53,7 @@ internal object ReferencedPolicies {
             return emptyMap()
         }
         val kept = RoleExpansion.effective(candidate).policies.associate { it.id to it.boundary }
-        return RoleExpansion.effective(base).policies.filter { kept[it.id] != it.boundary }.map { it.id }
+        return RoleExpansion.effective(base).policies.filter { it.id !in kept }.map { it.id }
             .associateWith { policy -> blocking(key, referrers(key, policy)) }
             .filterValues { it.isNotEmpty() }
     }
