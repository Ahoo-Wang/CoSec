diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/change/BreakGlass.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/change/BreakGlass.kt
index 17e011a2..390031ec 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/change/BreakGlass.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/change/BreakGlass.kt
@@ -69,12 +69,6 @@ class BreakGlass(private val changes: Changes, private val revisions: Revisions)
             expiresAt = expiresAt.toEpochMilli(),
             breakGlass = true,
         )
-        changes.authority.authorize(
-            operator,
-            SnapshotKey.Platform,
-            listOf(Operation.PutBinding(grant)),
