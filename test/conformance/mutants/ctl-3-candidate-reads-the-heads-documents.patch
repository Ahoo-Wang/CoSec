# Rule: CTL-3
# Mutant: a simulated tenant change is decided on the documents its head reads, not those the candidate makes the request read
# Tests: :control:test --tests me.ahoo.cosec.control.api.AppDocumentDecisionsTest :conformance:test
diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/api/DecisionQueries.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/api/DecisionQueries.kt
index eb6a87b5c..5630f4990 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/api/DecisionQueries.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/api/DecisionQueries.kt
@@ -62,7 +62,7 @@ internal class DecisionQueries(
             }
             val document = changes.candidateOf(id) ?: throw ChangeRejectedException.conflict(ConflictKind.STATE, "change ${id.value} no longer applies")
             // A tenant change may make the request read another app document, or none (RC1-17): as once it publishes.
-            val fetched = if (change.key == tenant) simulator.keys(scope, document) else keys
+            val fetched = keys
             // The candidate is no stored content: compiled once, here; the heads come from the cache.
             val proposedHeads = fetched.associateWith { heads[it] ?: retained.held(it) } + (change.key to Held(document, null))
             documents(proposedHeads).also { proposedDocuments = it }.let { simulator.decide(simulated, scope, it) }
