# Mutant: the login routes answer on every port of the host, the management port included
# Tests: :spring-boot:test --tests me.ahoo.cosec.spring.boot.realserver.ManagementPortTest

diff --git a/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/authentication/route/ReactiveLoginRoutes.kt b/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/authentication/route/ReactiveLoginRoutes.kt
