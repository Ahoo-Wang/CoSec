+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/authn/TokenAuthenticator.kt
@@ -71,7 +71,7 @@ class TokenAuthenticator(
     private val revocationSkew: Duration = SubjectRevocation.DEFAULT_SKEW,
 ) : Authenticator {
