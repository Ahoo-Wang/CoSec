# Rule: STA-13
# Mutant: a gateway host lists the application's controllers and router functions but not its own handler mappings, so a WebSocket endpoint is served with no CoSec decision and nothing names it (DR2-G-1)
# Tests: :spring-boot:test --tests me.ahoo.cosec.spring.boot.pipeline.GatewayOwnHandlersTest

diff --git a/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/pipeline/GatewayOwnHandlers.kt b/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/pipeline/GatewayOwnHandlers.kt
index 530eb1a1c..ecb24363d 100644
--- a/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/pipeline/GatewayOwnHandlers.kt
+++ b/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/pipeline/GatewayOwnHandlers.kt
@@ -56,7 +56,7 @@ internal object GatewayOwnHandlers {
         val controllers = beans.getBeanNamesForAnnotation(Controller::class.java).asList()
         val routers = beans.getBeanNamesForType(RouterFunction::class.java, true, false).asList()
         val mappings = beans.getBeanNamesForType(HandlerMapping::class.java, true, false).asList()
-        return (controllers + routers + mappings).distinct().filter {
+        return (controllers + routers).distinct().filter {
             applications(beans, it, beans.getType(it, false))
         }.sorted()
     }
