# Rule: CTL-79
# Mutant: the role class covers an app's or the platform's document, not only a tenant's
# Tests: :control:test --tests me.ahoo.cosec.control.api.RoleClassTest --tests me.ahoo.cosec.control.lifecycle.RoleClassUnitTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/RoleClass.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/RoleClass.kt
index 66f0ac473..bc4df5377 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/RoleClass.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/RoleClass.kt
@@ -55,7 +55,7 @@ internal object RoleClass {
      * [controlApp]. A removed role's app is the one [base] gives it; one [base] does not hold is not the class's.
      */
     fun covers(key: SnapshotKey, operations: List<Operation>, base: PolicyDocument?, controlApp: AppId): Boolean =
-        key is SnapshotKey.Tenant && operations.isNotEmpty() && operations.all { operation ->
+        operations.isNotEmpty() && operations.all { operation ->
             when (operation) {
                 is Operation.PutRole -> operation.role.app != controlApp
                 is Operation.RemoveRole -> base?.roles?.firstOrNull { it.id == operation.id }?.app.notIn(controlApp)
