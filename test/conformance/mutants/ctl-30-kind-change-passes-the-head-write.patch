# Rule: CTL-30
# Mutant: the head write lets a referenced policy change between a policy and a boundary
# Tests: :control:test --tests me.ahoo.cosec.control.change.BoundaryReferencesTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt
index a7012527..58c257fc 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt
@@ -700,7 +700,7 @@ class Revisions(
         }
         // What a short form derives is a policy like any other: tenants' roles may refer to it (RFC 0012 §7.5).
         val kept = RoleExpansion.effective(candidate).policies.associate { it.id to it.boundary }
-        val blocked = RoleExpansion.effective(base.document).policies.filter { kept[it.id] != it.boundary }.map { it.id }
+        val blocked = RoleExpansion.effective(base.document).policies.filter { it.id !in kept }.map { it.id }
