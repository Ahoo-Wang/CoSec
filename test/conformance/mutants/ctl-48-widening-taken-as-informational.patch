# Rule: CTL-48
# Mutant: the widening an app change needs approval for is counted as informational beside the tenants' entry, so the change publishes alone
# Tests: :control:test --tests me.ahoo.cosec.control.change.InformationalEscalationTest :conformance:test
diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/change/Escalation.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/change/Escalation.kt
index 130e438fc..21aa6f66e 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/change/Escalation.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/change/Escalation.kt
@@ -27,7 +27,7 @@ class Escalation(val subject: String, val reason: Reason, val detail: String = "
      * RC1-34), and the role class a change was granted by ([Reason.ROLE_CLASS], `CTL-79`). Their own change after an approval does not send the change back, since what was approved is widening
      * the policy. Nothing else is: an aggregated entry never stands in for one that needs an approval (`CTL-48`).
      */
-    val informational: Boolean get() = reason == Reason.TENANT_BINDINGS || reason == Reason.ROLE_CLASS
+    val informational: Boolean get() = reason == Reason.TENANT_BINDINGS || reason == Reason.ROLE_CLASS || reason == Reason.NOT_ANALYZED
 
     // A plain class, not a `data class`: a `ChangeEvent` carries it, so it is stable, and a field it gains is a new
     // constructor (RFC 0010 C4). It compares by value, as the change records it is part of do.
