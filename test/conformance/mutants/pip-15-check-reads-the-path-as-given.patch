--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/AuthorizationChecker.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/AuthorizationChecker.kt
@@ -94,7 +94,7 @@ class AuthorizationChecker(private val pipeline: Pipeline) {
     /** As [decide], with the action and resource given as the engine reads them. */
     @OptIn(InternalCoSecApi::class)
     suspend fun decide(security: RequestSecurity, action: Action, resource: Resource): Decision {
