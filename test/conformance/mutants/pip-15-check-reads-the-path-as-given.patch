# Rule: PIP-15
# Mutant: a check decides a resource as given, not as enforcement reads it
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.AuthorizationCheckerTest :conformance:test

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/AuthorizationChecker.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/AuthorizationChecker.kt
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/AuthorizationChecker.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/AuthorizationChecker.kt
@@ -98,7 +98,7 @@
     /** As [decide], with the action and resource given as the engine reads them. CoSec's own: the control plane's. */
     @InternalCoSecApi
     suspend fun decide(security: RequestSecurity, action: Action, resource: Resource): Decision {
-        val decidable = Enforceable.resource(resource) ?: return Decision.Deny(null)
+        val decidable = resource
         val decidedAs = Enforceable.action(action) ?: return Decision.Deny(null)
         return decided(security, decidedAs, decidable)
     }
