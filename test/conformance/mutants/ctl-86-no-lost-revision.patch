# Rule: CTL-86
# Mutant: no revision is ever listed above its head, so a head a failover moved back is never found
# Tests: :conformance:test --tests me.ahoo.cosec.conformance.ConformanceTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/LostRevisions.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/LostRevisions.kt
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/LostRevisions.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/LostRevisions.kt
@@ -34,5 +34,5 @@ suspend fun ControlStore.lostRevisions(key: SnapshotKey): List<RevisionEntry> {
     // The index first, then the head: see above.
     val index = index(key)?.value ?: return emptyList()
     val head = head(key) ?: return emptyList()
-    return index.entries.filter { it.revision > head.document.revision }
+    return index.entries.filter { it.revision > maxOf(head.document.revision, Long.MAX_VALUE) }
 }
