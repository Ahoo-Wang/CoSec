# Rule: GRT-6
# Mutant: the grant analysis reads only the app documents a change names, so a role-bound DENY of another app is not among the grantor's
# Tests: :control:test --tests me.ahoo.cosec.control.change.ChangesB1Test :conformance:test

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/EscalationAnalysis.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/EscalationAnalysis.kt
index e763e6d7..112886f8 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/EscalationAnalysis.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/EscalationAnalysis.kt
@@ -85,7 +85,7 @@ internal class EscalationAnalysis(private val analyzer: GrantAnalyzer, private v
         var listed = listedApps(documents)
         val apps = LinkedHashMap<AppId, PolicyDocument?>()
         val unread = HashSet<AppId>()
-        for (app in named + listed.orEmpty()) {
+        for (app in named) {
             appHead(documents, app)?.let { apps[app] = it.document } ?: run { unread += app }
         }
         // An app the change names has a head the list does not name: the list misses apps, so it says nothing.
