# Tests: :login:test --tests me.ahoo.cosec.login.token.SwitchLiveSessionTest :jwt:test --tests me.ahoo.cosec.jwt.SwitchFromReplayedPairTest :conformance:test

diff --git a/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/TokenFamilies.kt b/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/TokenFamilies.kt
index 4cdb070e2..424f6f60f 100644
--- a/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/TokenFamilies.kt
+++ b/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/TokenFamilies.kt
@@ -212,7 +212,10 @@ class TokenFamilies @JvmOverloads constructor(
                     requireRootLive(family)
                     return family
                 }
-                Standing.REUSED -> reused(read)
+                Standing.REUSED -> {
+                    requireRootLive(family)
+                    return family
+                }
                 Standing.NEVER_ISSUED -> throw TokenVerificationException(
                     "The token is of a generation its session never issued."
                 )
