# Tests: :control:test --tests me.ahoo.cosec.control.change.ShadowWindowTest :conformance:test

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/PublishRules.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/PublishRules.kt
