--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/stage/ReadRequest.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/stage/ReadRequest.kt
@@ -79,7 +79,7 @@ internal class ReadRequest(private val routes: RouteMap) : Stage {
      * app `0123`.
      */
