# Tests: :control:test --tests me.ahoo.cosec.control.change.PreemptionRaceTest :conformance:test

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Publishing.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Publishing.kt
index f79c2507..d74ee489 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Publishing.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Publishing.kt
@@ -134,7 +134,6 @@ internal class Publishing(
             head,
             candidate,
             PublishRules.publication(change, publisher, rechecked),
-            precondition = { slots.holds(change).also { slotLost = !it } },
         ) {
             published = written(change, it, rechecked, head?.document, candidate, publisher, again)
         }
