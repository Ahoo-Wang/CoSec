# Rule: PIP-31
# Mutant: the gateway forwards a method-override header it should remove, so a backend may run a POST as a DELETE the gateway never decided
# Tests: :gateway:test --tests me.ahoo.cosec.gateway.PipelineGatewayFilterTest :conformance:test

diff --git a/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt b/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt
index 70b17119c..15e3f1763 100644
--- a/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt
+++ b/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt
@@ -147,7 +147,7 @@ class PipelineGatewayFilter @InternalCoSecApi constructor(
      * that is absent allocates nothing ([MethodOverrideAllocationTest]).
      */
     private fun removeMethodOverrides(headers: HttpHeaders) {
-        for (name in METHOD_OVERRIDE_HEADERS) {
+        for (name in METHOD_OVERRIDE_HEADERS.take(0)) {
             headers.remove(name)
         }
     }
