--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ShadowWindows.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ShadowWindows.kt
@@ -69,7 +69,7 @@ class ShadowWindows(private val reports: ShadowReportReader, private val options
         val elapsed = java.time.Duration.between(state.startedAt, now)
         val summary = when {
             blocked -> ShadowSummary(counts, now, insufficient = false, blocked = true)
