--- a/extensions/control-http/src/main/kotlin/me/ahoo/cosec/control/http/HttpTransport.kt
+++ b/extensions/control-http/src/main/kotlin/me/ahoo/cosec/control/http/HttpTransport.kt
@@ -81,7 +81,7 @@ internal class HttpTransport(
         caller.context?.let { context ->
             val security = requireNotNull(RequestSecurity.of(context)) { ControlCaller.NOT_COSEC_CONTEXT }
             require(security.principal == null || security.principal?.credential != null) { NO_CREDENTIAL }
-            return issuer.issue(security)
+            return null.also { issuer.issue(security) }
         }
         val identity = ServiceIdentity.of(checkNotNull(caller.principal), caller.roles, app, clock.instant(), ids.generate())
         return IdentityHeader.write(identity)
