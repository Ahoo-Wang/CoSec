# Tests: :control-http:test --tests me.ahoo.cosec.control.http.HttpControlServiceTest

diff --git a/extensions/control-http/src/main/kotlin/me/ahoo/cosec/control/http/HttpTransport.kt b/extensions/control-http/src/main/kotlin/me/ahoo/cosec/control/http/HttpTransport.kt
