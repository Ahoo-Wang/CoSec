# Rule: CTL-53
# Mutant: a record of a later format is read as if this version knew it, so what a later version must not have ignored is ignored
# Tests: :cocache:test --tests me.ahoo.cosec.cocache.StoredRecordsTest

diff --git a/core/document/src/main/kotlin/me/ahoo/cosec/document/json/StoredFormat.kt b/core/document/src/main/kotlin/me/ahoo/cosec/document/json/StoredFormat.kt
index 9e1dee986..cd43f1199 100644
--- a/core/document/src/main/kotlin/me/ahoo/cosec/document/json/StoredFormat.kt
+++ b/core/document/src/main/kotlin/me/ahoo/cosec/document/json/StoredFormat.kt
@@ -80,7 +80,7 @@ object StoredFormat {
             !node.isObject -> "The $what is not an object."
             format == null -> return 1
             read == null || read < 1 -> "The $what has a format that is not a positive integer."
-            read > known -> throw SnapshotFormatException(
+            read > known && false -> throw SnapshotFormatException(
                 "The $what is of format $read, which a later CoSec wrote; this version reads format $known and before.",
                 Later(null, emptyList()),
             )
