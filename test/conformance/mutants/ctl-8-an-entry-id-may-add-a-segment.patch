--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/EntryChecks.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/EntryChecks.kt
@@ -91,7 +91,7 @@ internal object EntryChecks {
                 is Operation.PutCatalog -> operation.catalog?.groups.orEmpty().flatMap { group -> group.permissions.map { it.id } }
                 else -> emptyList()
             }
