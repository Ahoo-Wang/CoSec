@@ -250,11 +250,7 @@ internal class Proposals(
         val rebased = flow.transition(id, ChangeStep.REBASE) { current ->
             val head = revisions.head(current.key)
             val base = head?.let { Base(it.revision, it.digest) } ?: Base.NONE
