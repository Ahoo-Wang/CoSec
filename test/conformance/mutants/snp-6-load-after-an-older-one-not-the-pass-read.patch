# Rule: SNP-6
# Mutant: the load after one older than a pass is not counted as the pass's read, so a pass waiting on its slow read can be abandoned as stalled while that read is in flight, and its reads add to the next pass's (the runner's KeyLoads.advance)
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.snapshot.SnapshotRevalidationTest --tests me.ahoo.cosec.runtime.snapshot.KeyTransitionsTest

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt
index 2291c185..3f8a8844 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt
