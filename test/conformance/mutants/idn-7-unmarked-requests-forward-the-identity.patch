+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/stage/ForwardIdentity.kt
@@ -31,7 +31,7 @@ import me.ahoo.cosec.spi.identity.IdentityOverflowException
 internal class ForwardIdentity(private val issuer: IdentityIssuer) {
     fun run(state: RequestState, outcome: Outcome): Outcome {
         val security = outcome.security
