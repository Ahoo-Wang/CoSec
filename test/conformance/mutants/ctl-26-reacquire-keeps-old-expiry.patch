# Tests: :cocache:test --tests me.ahoo.cosec.cocache.control.ControlLeaseTest

diff --git a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/control/CoCacheControlStore.kt b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/control/CoCacheControlStore.kt
index fdc5943b..675fa423 100644
--- a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/control/CoCacheControlStore.kt
+++ b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/control/CoCacheControlStore.kt
@@ -235,9 +235,7 @@ class CoCacheControlStore internal constructor(
             if (current != holder) {
                 return false
             }
-            if (async.putIfMatch(name, cocacheDigest(digest), holder, duration).await() is ConditionalPut.Written) {
-                return true
-            }
+            return true
         }
         throw IllegalStateException(
             "The lease [$name] kept changing while it was taken; gave up after $MAX_LIST_ATTEMPTS attempts."
