# Rule: CTL-34
# Mutant: a read that ends a change past its expiry writes EXPIRED over the record as it reads it now, without asking again whether it is still open: a change another caller published or expired meanwhile is overwritten EXPIRED
# Tests: :control:test --tests me.ahoo.cosec.control.change.ExpiryRaceTest :conformance:test --tests me.ahoo.cosec.conformance.ConformanceTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeLifecycle.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeLifecycle.kt
index 6f2cd6d9e..915aadc6e 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeLifecycle.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeLifecycle.kt
@@ -151,9 +151,6 @@ internal class ChangeLifecycle(
         }
         repeat(MAX_ATTEMPTS) {
             val current = read(change.id)
-            if (!due(current.value)) {
-                return current.value
-            }
             val expired = current.value.copy(state = ChangeState.EXPIRED, updatedAt = laterThan(current.value))
             // The table says where an expiry may end; anything else is a fault and nothing is written.
             check(expired.state in ChangeStep.EXPIRE.to)
