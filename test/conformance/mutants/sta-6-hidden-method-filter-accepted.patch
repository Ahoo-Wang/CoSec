@@ -124,7 +124,7 @@ internal object GatewayModeTrust {
     }
 
     fun requireNoHiddenMethod(environment: Environment, beans: ListableBeanFactory, host: String? = null) {
-        val found = hiddenMethod(environment, beans) ?: return
