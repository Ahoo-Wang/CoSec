# Rule: SNP-3
# Mutant: CoSec's locks leave the key filter and the TTL function open, so a customizer's key filter can hide revocations
# Tests: :spring-boot:test --tests me.ahoo.cosec.spring.boot.authorization.cache.StoreOfRecordOverrideTest

diff --git a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt
index 46f68bd5..4c009d40 100644
--- a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt
+++ b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt
@@ -47,7 +47,7 @@ internal object CacheLocks {
     private val COMMAND_TIMEOUT: Duration = ChronoUnit.FOREVER.duration
 
     fun of(cacheName: String): Locks = Locks.builder(LOCKED_BY).apply {
-        lockLayout(*LayoutField.entries.toTypedArray())
+        lockLayout(*(LayoutField.entries - LayoutField.KEY_FILTER - LayoutField.TTL_OF).toTypedArray())
         when (cacheName) {
             in STORE_OF_RECORD_CACHE_NAMES -> {
                 verify { require(it is StoreSpec<*, *>) { "CoSec's ${it.name} is the store of record: a Store." } }
