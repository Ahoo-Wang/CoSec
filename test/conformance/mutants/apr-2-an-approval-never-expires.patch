# Rule: APR-2
# Mutant: a stored approval never expires: a change approved long ago still publishes
# Tests: :control:test --tests me.ahoo.cosec.control.ControlAuthorizationTest :conformance:test --tests me.ahoo.cosec.conformance.ConformanceTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ApprovalRules.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ApprovalRules.kt
index f162ed6b2..84a809d9f 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ApprovalRules.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ApprovalRules.kt
@@ -144,7 +144,6 @@ internal class ApprovalRules(
         val approval = change.approval ?: return "it needs an approval"
         return when {
             approval.candidate != change.candidate -> "the approval is for another candidate"
-            now.isAfter(approval.at.plus(options.approvalExpireAfter)) -> "the approval expired"
             approval.approver == change.author || approval.approver == publisher.actor ->
                 "the approval is the author's or the publisher's own"
             !approval.covers.containsAll(required.map { it.subject }) -> "the approval does not cover what it now needs"
