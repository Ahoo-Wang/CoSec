# Tests: :cocache:test --tests me.ahoo.cosec.cache.limiter.ReactiveRedisRateLimiterTest

diff --git a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/limiter/ReactiveRedisRateLimiter.kt b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/limiter/ReactiveRedisRateLimiter.kt
