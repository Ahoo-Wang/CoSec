# Rule: PIP-7
# Mutant: the revocation tables keep a read-timeout a layer sets, so a timeout shorter than the command timeout reads "not revoked" more often
# Tests: :cocache:test --tests me.ahoo.cosec.cache.CacheTtlPolicyTest

diff --git a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/CoSecCacheSpecs.kt b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/CoSecCacheSpecs.kt
index 814be36..0f96699 100644
--- a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/CoSecCacheSpecs.kt
+++ b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/CoSecCacheSpecs.kt
@@ -267,7 +267,6 @@ object CoSecCacheSpecs {
                 // A read that times out reads "not revoked" (unknown-read: absent, PIP-7): a timeout shorter than the
                 // store's command timeout, from cocache.defaults.store.read-timeout say, would widen that.
                 lock(PolicyField.READ_TIMEOUT)
-                constrain(PolicyField.READ_TIMEOUT) { COMMAND_TIMEOUT }
             }
 
             MEMBERSHIP_CACHE_NAME -> {
