# Tests: :cocache:test --tests me.ahoo.cosec.cache.control.CoCacheControlStoreTest

diff --git a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/control/ControlCacheSpecs.kt b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cache/control/ControlCacheSpecs.kt
