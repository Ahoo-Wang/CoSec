# Rule: IDN-2
# Mutant: an empty cap is read as no cap, so a key meant to hold nothing holds everything its principal holds
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.authn.ApiKeyAuthenticatorTest :conformance:test

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/authn/ApiKeyAuthenticator.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/authn/ApiKeyAuthenticator.kt
index aec7512d..66136710 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/authn/ApiKeyAuthenticator.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/authn/ApiKeyAuthenticator.kt
@@ -55,7 +55,7 @@ class ApiKeyAuthenticator(
         val principal = AuthenticatedPrincipal(
             id = PrincipalId(apiKey.principalId),
             tenant = TenantId(apiKey.tenantId),
-            membershipSource = apiKey.roles?.let(MembershipSource.Provider::capped) ?: MembershipSource.Provider.UNCAPPED,
+            membershipSource = apiKey.roles?.takeIf { it.isNotEmpty() }?.let(MembershipSource.Provider::capped) ?: MembershipSource.Provider.UNCAPPED,
             attributes = mapOf(ApiKey.API_KEY_ID_ATTRIBUTE to apiKey.id),
             credential = Identity.Credential(Identity.Method.API_KEY, apiKey.id, apiKey.expiresAt),
         )
