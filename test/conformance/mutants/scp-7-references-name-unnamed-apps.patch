# Rule: SCP-7
# Mutant: back-references build a key for every binding app, so a head that holds one in an app no key can name never publishes again
# Tests: :control:test --tests me.ahoo.cosec.control.change.UnnamedAppIdsTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt
index 8363daae..3b4a8146 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/Revisions.kt
@@ -593,7 +593,7 @@ class Revisions(
             val app = (binding.scope.app as? Match.Exactly)?.value?.value
             // An app no key can name has no document to refer to (R2-1 of #1194's review): earlier builds stored such
             // bindings, and the head that holds one must still publish the change that drops it.
-            if (document.kind == DocumentKind.TENANT && app != null && SnapshotKey.App.isValidAppId(app)) {
+            if (document.kind == DocumentKind.TENANT && app != null) {
                 references += SnapshotKey.App(app) to binding.policy
             }
         }
