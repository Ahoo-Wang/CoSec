# Rule: IDN-32
# Mutant: the cache's key leaves out the signature, so a token with a forged signature is answered as the one it copies
# Tests: :jwt:test --tests me.ahoo.cosec.jwt.VerifiedTokenCachePropertyTest

diff --git a/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/VerifiedTokenCache.kt b/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/VerifiedTokenCache.kt
index 07e6f3c..a35e935 100644
--- a/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/VerifiedTokenCache.kt
+++ b/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/VerifiedTokenCache.kt
@@ -87,7 +87,7 @@ class VerifiedTokenCache(val maxBytes: Long) {
     val held: Long get() = heldBytes.get()
 
     internal fun key(token: String): Key {
-        val digest = SHA_256.get().digest(token.toByteArray(Charsets.UTF_8))
+        val digest = SHA_256.get().digest(token.substringBeforeLast('.').toByteArray(Charsets.UTF_8))
         val bytes = ByteBuffer.wrap(digest)
         return Key(bytes.getLong(), bytes.getLong(), bytes.getLong(), bytes.getLong())
     }
