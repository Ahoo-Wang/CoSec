# Rule: IDN-29
# Mutant: the verifier tolerates the issuer skew with acceptLeeway, which loosens exp too, so an expired token is accepted for the skew
# Tests: :jwt:test --tests me.ahoo.cosec.jwt.IssuerSkewTest

diff --git a/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/JwtTokenVerifier.kt b/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/JwtTokenVerifier.kt
index 7d2cbe39..5b777268 100644
--- a/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/JwtTokenVerifier.kt
+++ b/extensions/jwt/src/main/kotlin/me/ahoo/cosec/jwt/JwtTokenVerifier.kt
@@ -70,8 +70,7 @@ class JwtTokenVerifier(
     // acceptIssuedAt and acceptNotBefore loosen only `iat` and `nbf`; acceptLeeway would loosen `exp` too.
     private val jwtVerifier: JWTVerifier = JWT.require(algorithm)
         .withClaimPresence("exp")
-        .acceptIssuedAt(skewSeconds)
-        .acceptNotBefore(skewSeconds)
+        .acceptLeeway(skewSeconds)
         .build()
 
     @Suppress("TooGenericExceptionCaught")
