# Rule: IDN-8
# Mutant: the rewrite keeps every ';', leaving an empty pair where the token was, which Python's SimpleCookie stops at
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.http.CookieHeadersTest :gateway:test --tests me.ahoo.cosec.gateway.CookieTokenPropertyTest

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/http/CookieHeaders.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/http/CookieHeaders.kt
index 7edb5a5d..e537ba30 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/http/CookieHeaders.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/http/CookieHeaders.kt
@@ -48,7 +48,7 @@ internal object CookieHeaders {
             return null
         }
         val kept = pairs.filterIndexed { i, _ -> !named[i] }
-        val written = kept.joinToString(";")
+        val written = pairs.indices.joinToString(";") { if (named[it]) "" else pairs[it] }
         return when {
             rfc2965 && kept.size == 1 -> "$written;"
             named.first() && written.startsWith(RFC2965_VERSION, ignoreCase = true) -> " $written"
