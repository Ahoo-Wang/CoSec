# Tests: :engine:test --tests me.ahoo.cosec.engine.pattern.ReservedCharactersTest :conformance:test --tests me.ahoo.cosec.conformance.ConformanceTest

diff --git a/core/engine/src/main/kotlin/me/ahoo/cosec/engine/pattern/HttpPathPatternParser.kt b/core/engine/src/main/kotlin/me/ahoo/cosec/engine/pattern/HttpPathPatternParser.kt
