--- a/core/engine/src/main/kotlin/me/ahoo/cosec/engine/pattern/HttpPathPatternParser.kt
+++ b/core/engine/src/main/kotlin/me/ahoo/cosec/engine/pattern/HttpPathPatternParser.kt
@@ -187,8 +187,13 @@ internal class HttpPathPatternParser(private val pattern: String, private val ca
                     if (escaped == '\\') {
                         throw invalid(begin + index, "a request path holds no backslash (PIP-14): \\\\ matches no path")
                     }
-                    literal.append(escaped)
-                    plain.append(escaped)
+                    if (escaped == '*') {
+                        flush()
+                        tokens.add(GlobToken.Run(-1))
+                    } else {
