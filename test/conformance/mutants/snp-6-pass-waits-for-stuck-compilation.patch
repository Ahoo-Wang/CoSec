# Rule: SNP-6
# Mutant: a periodic pass waits for a load that has been in flight longer than the store read timeout, so documents behind compilations that never end are never revalidated (the runner's KeyTransitions.load)
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.snapshot.SnapshotRevalidationTest

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyTransitions.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyTransitions.kt
index c4687c21..805d61c7 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyTransitions.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyTransitions.kt
@@ -128,7 +128,7 @@ internal class KeyTransitions<T : Any>(private val config: KeyConfig) {
             return
         }
         val inFlight = step.load
-        if (inFlight != null && pass != null && step.moment.nanos - inFlight.startedNanos > config.storeReadTimeout.toNanos()) {
+        if (inFlight != null && pass != null && step.moment.nanos - inFlight.startedNanos > Long.MAX_VALUE) {
             waiter?.let { step.emit(KeyEffect.Skip(it)) }
             return
         }
