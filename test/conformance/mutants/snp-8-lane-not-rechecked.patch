# Rule: SNP-8
# Mutant: the drain does not take the load lane again after its release, so a load's end offered while the flag was held waits for the next caller
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.snapshot.KeyDrainLaneTest

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyDrain.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyDrain.kt
index 705674ef..3a1104cb 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyDrain.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyDrain.kt
@@ -169,7 +169,6 @@ internal class KeyDrain<T : Any>(
                 hooks.afterRelease()
                 // An offer that lost the flag just before the release is taken here: no event is stranded. A lane
                 // event is taken again whatever the budget; only caller events are handed off.
-                if (lane != null) continue
                 if (spent) return handOff()
                 if (queue.isEmpty()) return
             }
