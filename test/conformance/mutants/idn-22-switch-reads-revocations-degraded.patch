# Tests: :login:test --tests me.ahoo.cosec.login.token.SwitchLiveSessionTest :conformance:test

diff --git a/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/LiveSessions.kt b/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/LiveSessions.kt
index 255956843..34eb58b2c 100644
--- a/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/LiveSessions.kt
+++ b/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/LiveSessions.kt
@@ -50,7 +50,10 @@ internal class LiveSessions(private val revocation: TokenRevocation, private val
     suspend fun presented(token: VerifiedToken): Live {
         val session = token.session ?: throw TokenVerificationException("The token belongs to no session: sign in again.")
         val tenant = token.tenant?.let(::TenantId) ?: TenantId.DEFAULT
-        revocation.check(token.id, tenant, PrincipalId(token.principal), token.issuedAt)
+        try {
+            revocation.check(token.id, tenant, PrincipalId(token.principal), token.issuedAt)
+        } catch (_: me.ahoo.cosec.spi.token.RevocationUnavailableException) {
+        }
         val family = families.requireCurrent(token)
         return Live(PrincipalId(token.principal), session, family.root ?: family.id)
     }
