# Rule: CTL-79
# Mutant: the role class sees only the grant analysis's escalations: its record stands beside one from elsewhere that needs approval
# Tests: :control:test --tests me.ahoo.cosec.control.api.RoleClassTest --tests me.ahoo.cosec.control.lifecycle.RoleClassUnitTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeAuthority.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeAuthority.kt
index 7bb4826b2..95cf4f0b0 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeAuthority.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ChangeAuthority.kt
@@ -276,7 +276,7 @@ class ChangeAuthority(
         // The role class lifts who-grants doubts of a roles-only change of a tenant's document, for a holder (CTL-79). It
         // sees every escalation of the change, so its record never stands beside one it may not lift.
         val change = RoleClass.Proposed(key, operations, base, controlApp)
-        return RoleClass.apply(escalations + unknown, change, operator.actor) {
+        return escalations + RoleClass.apply(unknown, change, operator.actor) {
             holds(operator, key, ControlActions.MANAGE_ROLES)
         }
     }
