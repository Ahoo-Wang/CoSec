# Rule: CTL-85
# Mutant: the record the open-change bound reads is held in no work budget
# Tests: :control:test --tests me.ahoo.cosec.control.store.OpenChangesReadTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/OpenLimit.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/OpenLimit.kt
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/OpenLimit.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/OpenLimit.kt
@@ -65,7 +65,7 @@ internal class OpenLimit(
         // One record at a time (DR2-E-4): of each only what the bound needs is kept, so the open changes of a document,
         // up to max-count times the cap of them, are never all decoded at once. The one being read is held in the call's
         // work, as decoded at the cap it weighs at most.
-        work.hold(author.tenant.value, flow.readWeight)
+        work.hold(author.tenant.value, 0)
         val open = ArrayList<Open>()
         // A change that does not read still counts: it may be open, and it may pin a revision. It weighs its share of the
         // bytes, a document's worth, so that it never refuses a change on its own.
