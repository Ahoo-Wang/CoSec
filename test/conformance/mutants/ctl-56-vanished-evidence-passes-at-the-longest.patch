# Rule: CTL-56
# Mutant: at the longest window, a window whose reporter vanished closes passing on the others' reports, its missing evidence counted as none
# Tests: :control:test --tests me.ahoo.cosec.control.change.ControlRoundTwoFixesTest :conformance:test --tests me.ahoo.cosec.conformance.ConformanceTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ShadowWindows.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ShadowWindows.kt
index 43621f280..9cc7d412c 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ShadowWindows.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/ShadowWindows.kt
@@ -91,7 +91,8 @@ class ShadowWindows(
         val summary = when {
             blocked -> ShadowSummary(counts, now, insufficient = false, blocked = true, vanished = vanished)
             vanished.isNotEmpty() && elapsed < options.maxDuration -> null
-            vanished.isEmpty() && acknowledged && elapsed >= options.minDuration && effective >= options.minSamples ->
+            (vanished.isEmpty() || elapsed >= options.maxDuration) && acknowledged && elapsed >= options.minDuration &&
+                effective >= options.minSamples ->
                 ShadowSummary(counts, now, insufficient = false, blocked = false)
             elapsed >= options.maxDuration -> ShadowSummary(counts, now, insufficient = true, blocked = false, vanished)
             else -> null
