# Rule: IDN-8
# Mutant: with forward-authorization on, a credential the pipeline rejected goes downstream when a public route permits the anonymous request, so a backend that verifies tokens itself sees one the gateway refused
# Tests: :conformance:test --tests me.ahoo.cosec.conformance.ConformanceTest

diff --git a/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt b/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt
index 2864560f..c8c83549 100644
--- a/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt
+++ b/edge/gateway/src/main/kotlin/me/ahoo/cosec/gateway/PipelineGatewayFilter.kt
@@ -107,7 +107,7 @@ class PipelineGatewayFilter @InternalCoSecApi constructor(
             val route = authorized.getAttribute<Route>(GATEWAY_ROUTE_ATTR)
             // The caller's credentials go only where its identity may go, only when asked for (RC1-5, RC1-49), and only
             // when the pipeline accepted them: a refused one, on a route anyone may use, stays here (R1A-7).
-            val credentials = forwardAuthorization && outcome.security?.principal != null &&
+            val credentials = forwardAuthorization &&
                 route != null && receivesIdentity(route)
             // Read before the builder's lambda: one it writes would be boxed, an allocation on every request.
             val cookies = if (credentials) null else withoutCookieTokens(request.headers)
