# Tests: :spring-boot:test --tests me.ahoo.cosec.spring.boot.UnknownPropertiesTest

diff --git a/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/UnknownProperties.kt b/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/UnknownProperties.kt
index c13a720e..3e523860 100644
--- a/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/UnknownProperties.kt
+++ b/host/spring-boot/src/main/kotlin/me/ahoo/cosec/spring/boot/UnknownProperties.kt
@@ -54,7 +54,7 @@ class UnknownProperties(
 
     /** Fails startup when [environment] has keys CoSec does not read. */
     fun check(environment: ConfigurableEnvironment) {
-        val unknown = of(environment)
+        val unknown = of(environment).filterNot { it.endsWith(".key-prefix") }
         if (unknown.isEmpty()) {
             return
         }
