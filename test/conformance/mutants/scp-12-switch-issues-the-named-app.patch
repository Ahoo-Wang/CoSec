# Rule: SCP-12
# Mutant: a tenant switch issues the token for the app the credentials name, not the one its TenantSwitch answers
# Tests: :login:test --tests me.ahoo.cosec.login.token.SwitchTenantAuthenticationTest :conformance:test

diff --git a/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/SwitchTenantAuthentication.kt b/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/SwitchTenantAuthentication.kt
index c7a102ba..5b29bb49 100644
--- a/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/SwitchTenantAuthentication.kt
+++ b/extensions/login/src/main/kotlin/me/ahoo/cosec/login/token/SwitchTenantAuthentication.kt
@@ -60,7 +60,9 @@ class SwitchTenantAuthentication<C : SwitchTenantCredentials>(
         val principal = RequestSecurity.of(previous)?.principal
             ?: throw TokenVerificationException("A switch is asked in a request the pipeline permitted.")
         val live = sessions.of(principal)
-        val subject = inTarget(previous, credentials.targetTenantId, tenantSwitch.switchTenant(credentials))
+        val answer = tenantSwitch.switchTenant(credentials)
+        val asked = credentials.targetAppId?.let { TenantMembership(answer.roles, answer.policies, answer.attributes, it) }
+        val subject = inTarget(previous, credentials.targetTenantId, asked ?: answer)
         return subject.inSession(live.fork(TenantId(credentials.targetTenantId)))
     }
 
