--- a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/RevokedTokenCache.kt
+++ b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/RevokedTokenCache.kt
@@ -41,7 +41,7 @@ interface RevokedTokenCache : Cache<String, Boolean> {
