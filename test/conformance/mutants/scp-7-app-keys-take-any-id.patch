+++ b/core/spi/src/main/kotlin/me/ahoo/cosec/spi/snapshot/SnapshotKey.kt
@@ -82,7 +82,7 @@ sealed interface SnapshotKey {
              * R1-6 of #1194's review), so the control plane takes no app key the data plane could never read, and no
