# Tests: :cocache:test --tests me.ahoo.cosec.cache.snapshot.SnapshotKeyEncoderTest :control:test --tests me.ahoo.cosec.control.api.ControlPlaneTest

diff --git a/core/spi/src/main/kotlin/me/ahoo/cosec/spi/snapshot/SnapshotKey.kt b/core/spi/src/main/kotlin/me/ahoo/cosec/spi/snapshot/SnapshotKey.kt
index 700aadc5..4a491609 100644
