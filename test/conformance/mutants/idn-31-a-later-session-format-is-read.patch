--- a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/TokenFamilyCodec.kt
+++ b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/TokenFamilyCodec.kt
@@ -56,7 +56,7 @@ internal object TokenFamilyCodec : Codec<TokenFamily> {
         } catch (_: JacksonException) {
             throw SnapshotFormatException("A stored $WHAT is not JSON.")
         }
-        StoredFormat.of(node, WHAT)
+        if (!node.isObject) throw SnapshotFormatException("A stored $WHAT is not an object.")
