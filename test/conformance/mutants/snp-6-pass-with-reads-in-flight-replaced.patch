--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/Pass.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/Pass.kt
@@ -56,7 +56,7 @@ internal class Pass(val done: CompletableFuture<Void>, private val context: Slot
      * flight; only one with no read can be, so [startRead] never succeeds after this does.
      */
     fun abandonIfStalled(now: Long): Boolean =
-        now - progressedAt > context.options.storeReadTimeout.toNanos() && reads.compareAndSet(0, ABANDONED)
+        now - progressedAt > context.options.storeReadTimeout.toNanos() && (reads.compareAndSet(0, ABANDONED) || reads.get() > 0)
 
