# Rule: OBS-1
# Mutant: a BEST_EFFORT listener whose queue is full fails the request that offers it an event, instead of dropping the event
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.event.ListenerIsolationTest :conformance:test --tests me.ahoo.cosec.conformance.ConformanceTest

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/event/DecisionListeners.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/event/DecisionListeners.kt
index 08f2b0e0e..b6a663a54 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/event/DecisionListeners.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/event/DecisionListeners.kt
@@ -249,6 +249,7 @@ class DecisionListeners(
             if (closed || size > queued.capacity) {
                 queued.size.decrementAndGet()
                 dropped(queued, closed)
+                check(closed) { "BEST_EFFORT queue full" }
                 continue
             }
             beforeOffer?.invoke()
diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/stage/PublishBestEffort.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/stage/PublishBestEffort.kt
index 8fdab5b07..cea056a12 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/stage/PublishBestEffort.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/stage/PublishBestEffort.kt
@@ -52,6 +52,8 @@ internal class PublishBestEffort(private val listeners: DecisionListeners, priva
             listeners.publish(state.event(state.eventId(ids), outcome, replay))
         } catch (e: CancellationException) {
             throw e
+        } catch (e: IllegalStateException) {
+            throw e
         } catch (_: Exception) {
             listeners.unpublished()
         }
