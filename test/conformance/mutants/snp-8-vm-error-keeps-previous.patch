--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt
@@ -119,7 +119,8 @@ internal class KeyLoads<T : Any>(private val config: KeyConfig) {
     ) {
         val confirmedAt = load.confirmedAt(config.localCopyMaxAge)
         val failed = DocumentState.Failed(failure)
-        finish(step, load, readEntry(step.key, failed, read, confirmedAt, EntryOrigin.UNCOMPILABLE), install = true)
+        val entry = readEntry(step.key, failed, read, confirmedAt, EntryOrigin.UNCOMPILABLE)
+        onTransientFailure(step, load, (entry.state as DocumentState.Failed).error)
     }
 
