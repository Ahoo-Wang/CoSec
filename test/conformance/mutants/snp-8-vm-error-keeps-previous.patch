# Rule: SNP-8
# Mutant: a VirtualMachineError while compiling ends the load as a transient failure, which keeps the previous revision
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.snapshot.*

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/Slot.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/Slot.kt
index aa6244b4..9d208ec4 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/Slot.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/Slot.kt
@@ -521,7 +521,7 @@ internal class Slot<T : Any>(
                 load.confirmedAt,
                 EntryOrigin.UNCOMPILABLE,
             )
-            finish(load, failed, install = true)
+            onTransientFailure(load, (failed.state as DocumentState.Failed).error)
             throw error
         }
         retryDelay = context.options.rejectedReloadRetry
