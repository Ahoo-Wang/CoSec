# Rule: SNP-8
# Mutant: a VirtualMachineError while compiling ends the load as a transient failure, which keeps the previous revision (the runner's KeyLoads.onCompileCrashed)
# Tests: :runtime:test --tests me.ahoo.cosec.runtime.snapshot.*

diff --git a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt
index 270a9a56..6b32c6ee 100644
--- a/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt
+++ b/core/runtime/src/main/kotlin/me/ahoo/cosec/runtime/snapshot/KeyLoads.kt
@@ -132,7 +132,7 @@ internal class KeyLoads<T : Any>(private val config: KeyConfig) {
                 confirmedAt,
                 EntryOrigin.UNCOMPILABLE
             )
-        finish(step, load, entry, install = true)
+        onTransientFailure(step, load, (entry.state as DocumentState.Failed).error)
     }
 
