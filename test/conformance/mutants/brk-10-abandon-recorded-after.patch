# Mutant: a break-glass change is abandoned whether or not its REQUIRED change listener records it
# Tests: :control:test --tests me.ahoo.cosec.control.change.BreakGlassControlTest :conformance:test

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Approvals.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Approvals.kt
index 6235795b..1075bbc3 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Approvals.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Approvals.kt
@@ -138,7 +138,7 @@ internal class Approvals(
         if (breakGlass) {
             PublishRules.requireState(current, ChangeStep.ABANDON.from)
             PublishRules.requireAudit(true, listeners.hasRequired)
-            flow.audit(ChangeEvent.Kind.ABANDONED, current.abandoned(), operator.actor, gated = true)
+            flow.audit(ChangeEvent.Kind.ABANDONED, current.abandoned(), operator.actor, gated = false)
         }
         val change = flow.transition(id, ChangeStep.ABANDON) { it.copy(state = ChangeState.ABANDONED) }
         slots.release(change)
