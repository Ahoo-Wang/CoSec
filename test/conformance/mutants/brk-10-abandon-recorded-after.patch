# Rule: BRK-10
# Mutant: a break-glass change is abandoned whether or not its REQUIRED change listener records it
# Tests: :control:test --tests me.ahoo.cosec.control.change.BreakGlassControlTest :conformance:test

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Changes.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Changes.kt
index 87eb42e6..1c10fa2f 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Changes.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/Changes.kt
@@ -513,7 +513,7 @@ class Changes(
         if (breakGlass) {
             PublishRules.requireState(current, OPEN)
             PublishRules.requireAudit(true, listeners.hasRequired)
-            audit(ChangeEvent.Kind.ABANDONED, current.abandoned(), operator.actor, gated = true)
+            audit(ChangeEvent.Kind.ABANDONED, current.abandoned(), operator.actor, gated = false)
         }
         val change = transition(id, OPEN) { it.copy(state = ChangeState.ABANDONED) }
         slots.release(change)
