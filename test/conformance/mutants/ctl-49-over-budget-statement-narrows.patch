# Mutant: past the comparison budget a statement is taken to narrow its previous version, so a widening the analysis did not compare grants nothing
# Tests: :control:test --tests me.ahoo.cosec.control.grant.ComparisonBudgetTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/grant/GrantNarrowing.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/grant/GrantNarrowing.kt
