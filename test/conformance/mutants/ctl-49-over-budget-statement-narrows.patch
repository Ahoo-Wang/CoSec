--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/grant/GrantNarrowing.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/grant/GrantNarrowing.kt
@@ -79,10 +79,10 @@ internal class GrantNarrowing(private val checker: ConditionChecker, private val
         }
         // Past the budget it is not known to narrow anything, so it is granted (CTL-49), without walking the rest.
         if (budget?.exhausted == true) {
-            return false
+            return true
         }
         return previous.statements.any {
-            budget?.spend() != false &&
+            budget?.spend() == false ||
                 (identical(statement, condition, it, previous) || narrows(statement, condition, it, both(previous.condition, it.condition)))
         }
     }
