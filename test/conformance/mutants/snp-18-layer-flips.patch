# Rule: SNP-18
# Mutant: a cocache.* layer may change whether a store is read-only
# Tests: :cocache:test --tests me.ahoo.cosec.cocache.ReadOnlyDeclarationTest

diff --git a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt
--- a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt
+++ b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/CacheLocks.kt
@@ -57,7 +57,6 @@ internal object CacheLocks {
         lockLayout(*LayoutField.entries.toTypedArray())
         // Read-only is CoSec's (SNP-18): where the control plane runs it writes the documents, and elsewhere a
         // read-only user must be enough; a property or customizer that changes it either way is refused here.
-        verify { readOnlyAsDeclared(it, readOnly) }
         when (cacheName) {
             in SET_OF_RECORD_CACHE_NAMES -> {
                 verify { require(it is SetStoreSpec<*, *>) { "CoSec's ${it.name} is the store of record: a SetStore." } }
