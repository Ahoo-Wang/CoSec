# Rule: CTL-25
# Mutant: a revision's removal of a reference it dropped removes it whatever revision indexed it, so a late removal takes back what a later revision indexed again
# Tests: :control:test --tests me.ahoo.cosec.control.store.ReferrerCleanupRaceTest :conformance:test

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferrerIndex.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferrerIndex.kt
index 70f21b4f..e9542d8b 100644
--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferrerIndex.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/store/ReferrerIndex.kt
@@ -210,7 +210,7 @@ internal class ReferrerIndex(
      * and so does one of a revision whose publish lost its race, a superset that blocks a deletion at most.
      */
     fun dropped(referrers: Map<SnapshotKey, Long>, key: SnapshotKey, revision: Long): Map<SnapshotKey, Long> {
-        val current = referrers[key] ?: return referrers
-        return if (current <= revision) referrers - key else referrers
+        referrers[key] ?: return referrers
+        return referrers - key
     }
 }
