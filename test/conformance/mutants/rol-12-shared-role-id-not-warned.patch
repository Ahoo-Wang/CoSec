--- a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/RoleChecks.kt
+++ b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/RoleChecks.kt
@@ -115,7 +115,7 @@ internal object RoleChecks {
             )
         }
         for ((r, role) in candidate.roles.withIndex()) {
