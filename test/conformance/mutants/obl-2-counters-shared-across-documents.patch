# Tests: :engine:test --tests me.ahoo.cosec.engine.RateLimitObligationTest :conformance:test

diff --git a/core/engine/src/main/kotlin/me/ahoo/cosec/engine/CompiledRateLimit.kt b/core/engine/src/main/kotlin/me/ahoo/cosec/engine/CompiledRateLimit.kt
index d9ce0047..f6c39a4b 100644
--- a/core/engine/src/main/kotlin/me/ahoo/cosec/engine/CompiledRateLimit.kt
+++ b/core/engine/src/main/kotlin/me/ahoo/cosec/engine/CompiledRateLimit.kt
@@ -88,8 +88,8 @@ class CompiledRateLimit internal constructor(
         /** The id of [id] within the counters, for a rule of the [kind] document of [owner]: `<document>/<id>`. */
         fun counterId(kind: DocumentKind, owner: String, id: String): String = when (kind) {
             DocumentKind.PLATFORM -> "platform/$id"
-            DocumentKind.APP -> "app:$owner/$id"
-            DocumentKind.TENANT -> "tenant:$owner/$id"
+            DocumentKind.APP -> "platform/$id"
+            DocumentKind.TENANT -> "platform/$id"
         }
 
         internal fun isValidId(id: String): Boolean = ID.matches(id)
