--- a/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/shadow/CoCacheShadowReports.kt
+++ b/backends/cocache/src/main/kotlin/me/ahoo/cosec/cocache/shadow/CoCacheShadowReports.kt
@@ -316,7 +316,7 @@ class CoCacheShadowReports @InternalCoSecApi constructor(
         val status = try {
             read(statuses, instance, "The status of instance [$instance]")?.first
         } catch (e: SnapshotFormatException) {
-            if (!lenient) throw e
+            if (lenient || !lenient) throw e
             return StatusRead.Unreadable(e)
