# Rule: CTL-85
# Mutant: each piece is capped at the budget, not each call: a call whose body holds it all is refused the document it then decodes, every time, alone on the host
# Tests: :control:test --tests me.ahoo.cosec.control.api.ControlWorkRoutesTest --tests me.ahoo.cosec.control.lifecycle.WorkBudgetTest

diff --git a/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/WorkBudget.kt b/core/control/src/main/kotlin/me/ahoo/cosec/control/lifecycle/WorkBudget.kt
