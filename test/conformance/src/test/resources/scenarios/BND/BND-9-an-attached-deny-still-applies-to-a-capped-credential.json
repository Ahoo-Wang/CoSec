{
  "rules": [
    "BND-9"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "RC1-1: alice attaches a DENY of order:read, and her role ops allows order:*; her capped credential holds ops, and the attached DENY still applies.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "ops",
            "statements": [
              {
                "effect": "allow",
                "action": "order:*"
              }
            ]
          },
          {
            "id": "no-read",
            "attachable": true,
            "statements": [
              {
                "effect": "deny",
                "action": "order:read"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "*",
            "space": "*",
            "policy": "ops"
          }
        ]
      }
    }
  },
  "credential": {
    "tenant": "acme",
    "id": "alice",
    "roles": [
      "ops"
    ],
    "policies": [
      "no-read"
    ],
    "principalBindings": false
  },
  "expect": {
    "decision": "Deny",
    "by": {
      "policy": "no-read",
      "statement": 0,
      "via": {
        "attached": "no-read"
      }
    }
  }
}
