{
  "rules": [
    "BND-6"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "An app document binds role editor of tenant globex; alice of acme is editor too.",
  "documents": {
    "apps": {
      "order-service": {
        "policies": [
          {
            "id": "perm:order-service/perm-read",
            "statements": [
              {
                "effect": "allow",
                "action": "*"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "r:editor:perm-read",
            "subject": {
              "role": "editor",
              "tenant": "globex"
            },
            "app": "order-service",
            "space": "*",
            "policy": "perm:order-service/perm-read"
          }
        ]
      }
    }
  },
  "credential": {
    "roles": [
      "editor"
    ],
    "app": "order-service"
  },
  "request": {},
  "expect": {
    "decision": "Deny",
    "by": null
  }
}
