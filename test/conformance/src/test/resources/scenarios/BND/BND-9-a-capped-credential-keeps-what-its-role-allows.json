{
  "rules": [
    "BND-9"
  ],
  "polarity": "negative",
  "level": "engine",
  "description": "The same capped credential, with nothing bound to alice that denies order:read, is permitted by its role.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "ops",
            "statements": [
              {
                "effect": "allow",
                "action": "order:*"
              }
            ]
          },
          {
            "id": "no-delete",
            "statements": [
              {
                "effect": "deny",
                "action": "order:delete"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "*",
            "space": "*",
            "policy": "ops"
          },
          {
            "id": "p:alice",
            "subject": {
              "principal": "alice",
              "tenant": "acme"
            },
            "app": "*",
            "space": "*",
            "policy": "no-delete"
          }
        ]
      }
    }
  },
  "credential": {
    "tenant": "acme",
    "id": "alice",
    "roles": [
      "ops"
    ],
    "principalBindings": false
  },
  "expect": {
    "decision": "Permit",
    "by": {
      "policy": "ops",
      "statement": 0,
      "via": {
        "binding": "ops",
        "document": "tenant"
      }
    }
  }
}
