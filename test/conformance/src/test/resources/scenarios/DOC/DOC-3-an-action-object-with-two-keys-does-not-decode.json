      "schema": 2,
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": {
                "all": {},
                "path": "/admin/**"
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        }
      ]
    }
  },
  "expect": {
    "decision": "NotCompiled",
    "error": "expected a string, found an object"
  }
