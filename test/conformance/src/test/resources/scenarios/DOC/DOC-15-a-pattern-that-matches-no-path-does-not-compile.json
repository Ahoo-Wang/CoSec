      "policies": [
        {
          "id": "reserved",
          "statements": [
            {
              "effect": "deny",
              "action": "http:GET",
              "resource": "http:path:/admin/x;y"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "reserved",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "reserved"
        }
      ]
    }
  },
  "expect": {
    "decision": "NotCompiled",
    "error": "hold no ';'"
  }
}
