{
  "rules": [
    "DOC-4"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "After a leading ** a glob segment is tried against two segments, so it costs twice: x*, then 1,022 letters, is three tokens and 1,023 literal characters, 1,026 units, so 2,052 after **, over the bound of 2,048.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "globs",
          "statements": [
            {
              "effect": "deny",
              "action": "http:GET",
              "resource": [
                "http:path:/**/x*"
              ]
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "globs",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "globs"
        }
      ]
    }
  },
  "expect": {
    "decision": "NotCompiled",
    "error": "more than 2048"
  }
}
