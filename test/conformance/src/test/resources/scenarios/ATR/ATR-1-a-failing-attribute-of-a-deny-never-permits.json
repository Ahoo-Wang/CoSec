{
  "rules": [
    "ATR-1"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "An ALLOW matches, and a DENY reads ext.geo.inFence, whose provider fails: the DENY may have matched, so never a Permit.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        },
        {
          "id": "deny-in-fence",
          "statements": [
            {
              "effect": "deny",
              "action": "*",
              "condition": {
                "eq": [
