                  true
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        },
        {
          "id": "g:deny-in-fence",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "deny-in-fence"
        }
      ]
    }
  },
  "attributeProviders": [
    {
      "stage": "B",
      "declares": {
        "ext.geo.inFence": "bool"
      },
      "fails": "geo is down"
    }
  ],
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
