{
  "rules": [
    "ATR-8"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "The same boundary, and the geo provider fails: the boundary cannot be decided, 503, never a permit.",
  "documents": {
    "platform": {
      "boundaries": {
        "default": "fence"
      },
      "policies": [
        {
          "id": "all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        },
        {
          "id": "fence",
          "boundary": true,
          "statements": [
            {
              "effect": "allow",
              "action": "*",
              "condition": {
                "eq": [
                  "ext.geo.inFence",
                  true
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "all"
        }
      ]
    }
  },
  "authentication": {
    "result": "authenticated",
    "tenant": "acme",
    "id": "alice"
  },
  "attributeProviders": [
    {
      "stage": "B",
      "declares": {
        "ext.geo.inFence": "bool"
      },
      "fails": "geo is down"
    }
  ],
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
