{
  "rules": [
    "CTL-48"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "Under four-eyes plato widens perm:order/read, which acme's and globex's readers bind in app order. The change lists the two tenants as one informational TENANT_BINDINGS entry beside NOT_ANALYZED, and the aggregated entry does not stand in for the approval: plato cannot publish it alone, and the change stays waiting for an approval.",
  "documents": {
    "platform": {
      "bindings": [
        {
          "id": "plato",
          "subject": {
            "principal": "plato",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        },
        {
          "id": "pia",
          "subject": {
            "principal": "pia",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        }
      ]
    },
    "apps": {
      "order": {
        "policies": [
          {
            "id": "perm:order/read",
            "statements": [
              {
                "effect": "allow",
                "action": "order:read"
              }
            ]
          }
        ]
      }
    },
    "tenants": {
      "acme": {
        "bindings": [
          {
            "id": "readers",
            "subject": {
              "role": "reader"
            },
            "app": "order",
            "space": "*",
            "policy": "perm:order/read"
          }
        ]
      },
      "globex": {
        "bindings": [
          {
            "id": "readers",
            "subject": {
              "role": "reader"
            },
            "app": "order",
            "space": "*",
            "policy": "perm:order/read"
          }
        ]
      }
    }
  },
  "operators": {
    "plato": {
      "tenant": "(platform)"
    },
    "pia": {
      "tenant": "(platform)"
    }
  },
  "options": {
    "fourEyes": true
  },
  "steps": [
    {
      "propose": {
        "change": "c1",
        "by": "plato",
        "document": "app:order",
        "operations": [
          {
            "putPolicy": {
              "id": "perm:order/read",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:*"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "stage": {
        "change": "c1",
        "by": "plato"
      }
    },
    {
      "shadowed": "c1"
    },
    {
      "publish": {
        "change": "c1",
        "by": "plato"
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "SHADOWING",
      "AWAITING_APPROVAL",
      "refused 409 STATE"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "app:order": 1
    },
    "escalations": {
      "c1": [
        "NOT_ANALYZED",
        "TENANT_BINDINGS"
      ]
    }
  }
}
