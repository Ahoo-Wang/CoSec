{
  "rules": [
    "CTL-1"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "The same second change with a condition that compiles is checked, published, and moves the head to revision 2.",
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "tenant:acme",
        "operations": [
          {
            "putPolicy": {
              "id": "read",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c1"
    },
    {
      "publish": "c1"
    },
    {
      "propose": {
        "change": "c2",
        "document": "tenant:acme",
        "operations": [
          {
            "putPolicy": {
              "id": "fine",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read",
                  "condition": {
                    "eq": [
                      "scope.space",
                      "team-a"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c2"
    },
    {
      "publish": "c2"
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "READY",
      "PUBLISHED",
      "CHECKED",
      "READY",
      "PUBLISHED"
    ],
    "errors": {
      "c1": [],
      "c2": []
    },
    "heads": {
      "tenant:acme": 2
    }
  }
}
