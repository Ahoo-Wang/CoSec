{
  "rules": [
    "CTL-70"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "alice, a tenant-admin of acme, proposes a change with her token. She and vera, a tenant-viewer of acme, read it: neither approves changes of acme's document nor reads the platform's, so each is told only that the identity was verified and by which method, and is given neither the credential's id nor the request's id, not even as empty members.",
  "documents": {
    "platform": {
      "bindings": [
        {
          "id": "plato",
          "subject": {
            "principal": "plato",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        }
      ]
    },
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "orders",
            "statements": [
              {
                "effect": "allow",
                "action": "order:*",
                "resource": "order/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "admins",
            "subject": {
              "role": "admin"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "cosec:tenant-admin"
          },
          {
            "id": "viewers",
            "subject": {
              "role": "viewer"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "cosec:tenant-viewer"
          },
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "order",
            "space": "*",
            "policy": "orders"
          }
        ]
      },
      "globex": {
        "policies": [
          {
            "id": "orders",
            "statements": [
              {
                "effect": "allow",
                "action": "order:read",
                "resource": "order/**"
              }
            ]
          }
        ]
      }
    }
  },
  "operators": {
    "alice": {
      "tenant": "acme",
      "roles": [
        "admin",
        "ops@team-a"
      ]
    },
    "vera": {
      "tenant": "acme",
      "roles": [
        "viewer"
      ]
    },
    "plato": {
      "tenant": "(platform)"
    }
  },
  "steps": [
    {
      "propose": {
        "by": "alice",
        "change": "c1",
        "document": "tenant:acme",
        "operations": [
          {
            "putPolicy": {
              "id": "more",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read",
                  "resource": "order/**"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "origin": {
        "by": "alice",
        "change": "c1"
      }
    },
    {
      "origin": {
        "by": "vera",
        "change": "c1"
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "origin asserted false via oidc; members asserted,via.method",
      "origin asserted false via oidc; members asserted,via.method"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "tenant:acme": 1
    }
  }
}
