{
  "rules": [
    "CTL-25"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "Tenant acme binds the platform policy shared at revision 1 and drops it at revision 2, whose removal from the back-reference index waits until revision 3 has bound it again: the removal leaves the reference revision 3 indexed, so a platform candidate without shared is refused and the platform head stays at revision 1.",
  "publishes": [
    {
      "document": "platform",
      "policies": [
        "shared",
        "other"
      ]
    },
    {
      "bindings": [
        "shared"
      ]
    },
    {
      "holdRemovals": true
    },
    {
      "bindings": [
        "shared"
      ]
    },
    {
      "document": "platform",
      "policies": [
        "other"
      ]
    }
  ],
  "expect": {
    "outcomes": [
      "Published",
      "Published",
      "Published",
      "Published",
      "Referenced"
    ],
    "head": {
      "revision": 1,
      "parent": null,
      "parentRecord": null
    },
    "records": 1,
    "writes": [
      "record",
      "head",
      "record",
      "head",
      "record",
      "head",
      "record",
      "head"
    ]
  }
}
