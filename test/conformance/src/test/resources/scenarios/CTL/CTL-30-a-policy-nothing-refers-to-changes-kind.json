{
  "rules": [
    "CTL-30"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "Nothing refers to the platform's shared, so turning it into a boundary is published like any other change of the platform's document.",
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "shared",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c1"
    },
    {
      "publish": "c1"
    },
    {
      "propose": {
        "change": "c2",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "shared",
              "boundary": true,
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c2"
    },
    {
      "publish": "c2"
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "READY",
      "PUBLISHED",
      "CHECKED",
      "READY",
      "PUBLISHED"
    ],
    "errors": {
      "c1": [],
      "c2": []
    },
    "heads": {
      "platform": 2
    }
  }
}
