{
  "rules": [
    "CTL-29"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "The same change checks clean while no tenant holds a copy of [shared].",
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "shared",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c1"
    },
    {
      "publish": "c1"
    },
    {
      "propose": {
        "change": "c2",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "shared",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:*"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "READY",
      "PUBLISHED",
      "CHECKED"
    ],
    "errors": {
      "c1": [],
      "c2": []
    },
    "heads": {
      "platform": 1
    }
  }
}
