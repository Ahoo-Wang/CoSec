{
  "rules": [
    "CTL-56"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "G2d: i1 and i2 keep reporting, and together they have enough samples: the window closes as soon as it may, not insufficient, and the change publishes without an acknowledgement.",
  "options": {
    "shadow": {
      "minDuration": "PT0S",
      "minSamples": 6,
      "maxDuration": "PT1H"
    }
  },
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "tenant:acme",
        "operations": [
          {
            "putPolicy": {
              "id": "read",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "stage": "c1"
    },
    {
      "report": {
        "change": "c1",
        "instance": "i1",
        "counts": {
          "SAME": 1
        }
      }
    },
    {
      "report": {
        "change": "c1",
        "instance": "i2",
        "counts": {
          "SAME": 1
        }
      }
    },
    {
      "shadowed": "c1"
    },
    {
      "report": {
        "change": "c1",
        "instance": "i1",
        "counts": {
          "SAME": 6
        }
      }
    },
    {
      "report": {
        "change": "c1",
        "instance": "i2",
        "counts": {
          "SAME": 1
        }
      }
    },
    {
      "shadowed": "c1"
    },
    {
      "publish": "c1"
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "SHADOWING",
      "reported",
      "reported",
      "SHADOWING",
      "reported",
      "reported",
      "READY",
      "PUBLISHED"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "tenant:acme": 1
    }
  }
}
