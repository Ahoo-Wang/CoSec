{
  "rules": [
    "CTL-30"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "acme's boundary is the platform's fence. Turning fence into an ordinary policy would leave acme's boundary missing: every permit in acme would be indeterminate. The control plane refuses it (422), naming tenant:acme, and the head stays.",
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "fence",
              "boundary": true,
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c1"
    },
    {
      "publish": "c1"
    },
    {
      "propose": {
        "change": "c2",
        "document": "tenant:acme",
        "operations": [
          {
            "setBoundary": "fence"
          }
        ]
      }
    },
    {
      "skipShadow": "c2"
    },
    {
      "publish": "c2"
    },
    {
      "propose": {
        "change": "c3",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "fence",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "READY",
      "PUBLISHED",
      "CHECKED",
      "READY",
      "PUBLISHED",
      "DRAFT"
    ],
    "errors": {
      "c1": [],
      "c2": [],
      "c3": [
        "REFERENCES"
      ]
    },
    "heads": {
      "platform": 1,
      "tenant:acme": 1
    }
  }
}
