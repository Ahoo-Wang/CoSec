{
  "rules": [
    "CTL-3"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "The platform's DENY is on order/**: deleting an invoice is not denied by it; no ALLOW covers it either, so the implicit deny decides, with no statement.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "no-delete",
          "statements": [
            {
              "effect": "deny",
              "action": "order:delete",
              "resource": "order/**"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "plato",
          "subject": {
            "principal": "plato",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        },
        {
          "id": "no-delete",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-delete"
        }
      ]
    },
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "orders",
            "statements": [
              {
                "effect": "allow",
                "action": "order:*",
                "resource": "order/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "admins",
            "subject": {
              "role": "admin"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "cosec:tenant-admin"
          },
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "order",
            "space": "*",
            "policy": "orders"
          }
        ]
      }
    }
  },
  "operators": {
    "alice": {
      "tenant": "acme",
      "roles": [
        "admin",
        "ops@team-a"
      ]
    },
    "plato": {
      "tenant": "(platform)"
    }
  },
  "steps": [
    {
      "simulate": {
        "by": "plato",
        "request": {
          "tenant": "acme",
          "principal": "bob",
          "roles": [
            "ops@team-a"
          ],
          "app": "order",
          "space": "team-a",
          "action": "order:delete",
          "resource": "invoice/1"
        }
      }
    },
    {
      "simulate": {
        "by": "plato",
        "request": {
          "tenant": "acme",
          "principal": "bob",
          "roles": [
            "ops@team-a"
          ],
          "app": "order",
          "space": "team-a",
          "action": "order:read",
          "resource": "order/1"
        }
      }
    }
  ],
  "expect": {
    "steps": [
      "Deny",
      "Permit by orders"
    ],
    "errors": {},
    "heads": {}
  }
}
