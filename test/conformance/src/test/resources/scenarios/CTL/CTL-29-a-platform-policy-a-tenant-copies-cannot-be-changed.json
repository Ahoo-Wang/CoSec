{
  "rules": [
    "CTL-29"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "RFC 0007 §9.4 (#1224): tenant acme holds an exact copy of [shared]; changing the platform's policy would leave one id with two contents, so it is refused (422).",
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "shared",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c1"
    },
    {
      "publish": "c1"
    },
    {
      "propose": {
        "change": "c2",
        "document": "tenant:acme",
        "operations": [
          {
            "putPolicy": {
              "id": "shared",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "skipShadow": "c2"
    },
    {
      "publish": "c2"
    },
    {
      "propose": {
        "change": "c3",
        "document": "platform",
        "operations": [
          {
            "putPolicy": {
              "id": "shared",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:*"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "READY",
      "PUBLISHED",
      "CHECKED",
      "READY",
      "PUBLISHED",
      "DRAFT"
    ],
    "errors": {
      "c1": [],
      "c2": [],
      "c3": [
        "V2"
      ]
    },
    "heads": {
      "platform": 1,
      "tenant:acme": 1
    }
  }
}
