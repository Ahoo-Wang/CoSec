{
  "rules": [
    "CTL-87",
    "BDY-2"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "DR1-E-3: what the platform means acme not to lift is its boundary: alice, acme's administrator, cannot set it, where she may remove any DENY of acme's document.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "fence",
          "boundary": true,
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "plato",
          "subject": {
            "principal": "plato",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        }
      ]
    },
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "orders",
            "statements": [
              {
                "effect": "allow",
                "action": "order:*",
                "resource": "order/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "admins",
            "subject": {
              "role": "admin"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "cosec:tenant-admin"
          },
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "order",
            "space": "*",
            "policy": "orders"
          }
        ]
      }
    }
  },
  "operators": {
    "alice": {
      "tenant": "acme",
      "roles": [
        "admin"
      ]
    },
    "plato": {
      "tenant": "(platform)"
    }
  },
  "steps": [
    {
      "propose": {
        "change": "c1",
        "by": "alice",
        "document": "tenant:acme",
        "operations": [
          {
            "setBoundary": "fence"
          }
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      "refused 403"
    ],
    "errors": {},
    "heads": {
      "tenant:acme": 1
    }
  }
}
