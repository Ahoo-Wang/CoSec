{
  "rules": [
    "CTL-56"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "G2d: i2 reported on the window and then vanished. Its evidence is missing, never zero: the window waits for it, and at the longest window it closes insufficient, naming i2. It never passes on i1's samples alone, so publishing needs the summary acknowledged.",
  "options": {
    "shadow": {
      "minDuration": "PT0S",
      "minSamples": 6,
      "maxDuration": "PT1H"
    }
  },
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "tenant:acme",
        "operations": [
          {
            "putPolicy": {
              "id": "read",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "stage": "c1"
    },
    {
      "report": {
        "change": "c1",
        "instance": "i1",
        "counts": {
          "SAME": 1
        }
      }
    },
    {
      "report": {
        "change": "c1",
        "instance": "i2",
        "counts": {
          "SAME": 1
        }
      }
    },
    {
      "shadowed": "c1"
    },
    {
      "report": {
        "change": "c1",
        "instance": "i1",
        "counts": {
          "SAME": 6
        }
      }
    },
    {
      "vanish": "i2"
    },
    {
      "shadowed": "c1"
    },
    {
      "advance": "PT59M"
    },
    {
      "shadowed": "c1"
    },
    {
      "advance": "PT2M"
    },
    {
      "shadowed": "c1"
    },
    {
      "publish": "c1"
    },
    {
      "publish": {
        "change": "c1",
        "ack": "summary"
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "SHADOWING",
      "reported",
      "reported",
      "SHADOWING",
      "reported",
      "vanished",
      "SHADOWING",
      "advanced",
      "SHADOWING",
      "advanced",
      "READY",
      "refused 428",
      "PUBLISHED"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "tenant:acme": 1
    }
  }
}
