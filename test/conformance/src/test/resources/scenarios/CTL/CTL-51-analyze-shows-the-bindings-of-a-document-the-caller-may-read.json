{
  "rules": [
    "CTL-51"
  ],
  "polarity": "negative",
  "level": "control",
  "documents": {
    "platform": {
      "bindings": [
        {
          "id": "plato",
          "subject": {
            "principal": "plato",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        }
      ]
    },
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "analyst",
            "statements": [
              {
                "effect": "allow",
                "action": "cosec:analyze",
                "resource": "doc/tenant/acme"
              }
            ]
          },
          {
            "id": "orders",
            "statements": [
              {
                "effect": "allow",
                "action": "order:read",
                "resource": "order/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "admins",
            "subject": {
              "role": "admin"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "cosec:tenant-admin"
          },
          {
            "id": "analysts",
            "subject": {
              "role": "analyst"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "analyst"
          },
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "order",
            "space": "*",
            "policy": "orders"
          }
        ]
      }
    }
  },
  "operators": {
    "plato": {
      "tenant": "(platform)"
    },
    "alice": {
      "tenant": "acme",
      "roles": [
        "admin"
      ]
    },
    "viv": {
      "tenant": "acme",
      "roles": [
        "analyst"
      ]
    }
  },
  "description": "DR1-F-8: alice, acme's administrator, holds cosec:read on acme's document: analyze lists its binding ops, which grants order:read on order/1, and counts the platform's document, which she may not read, as hidden.",
  "steps": [
    {
      "analyze": {
        "by": "alice",
        "query": {
          "tenant": "acme",
          "action": "order:read",
          "resource": "order/1"
        }
      }
    }
  ],
  "expect": {
    "steps": [
      "allows ops denies none hidden 1"
    ],
    "errors": {},
    "heads": {}
  }
}
