  "polarity": "positive",
  "level": "control",
  "description": "RFC 0007 §7.4.6 row 10: granting oneself cosec:* on doc/** is not contained in tenant-admin's doc/tenant/{t}/**; it goes to approval.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "cosec:tenant-admin",
          "statements": [
            {
              "effect": "allow",
