{
  "rules": [
    "GRT-6"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "RC1-4: billing denies order:delete to auditors only; alice is not one, so her grant of order:* to bob is contained in what she holds and needs nobody else.",
  "documents": {
    "apps": {
      "billing": {
        "policies": [
          {
            "id": "perm:billing/no-delete",
            "statements": [
              {
                "effect": "deny",
                "action": "order:delete"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "no-delete",
            "subject": {
              "role": "auditor"
            },
            "app": "billing",
            "space": "*",
            "policy": "perm:billing/no-delete"
          }
        ]
      }
    },
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "orders",
            "statements": [
              {
                "effect": "allow",
                "action": "order:*",
                "resource": "order/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "admins",
            "subject": {
              "role": "admin"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "cosec:tenant-admin"
          },
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "*",
            "space": "",
            "policy": "orders"
          }
        ]
      }
    }
  },
  "operators": {
    "alice": {
      "tenant": "acme",
      "roles": [
        "admin",
        "ops"
      ]
    }
  },
  "steps": [
    {
      "propose": {
        "change": "c1",
        "by": "alice",
        "document": "tenant:acme",
        "operations": [
          {
            "putBinding": {
              "id": "bob",
              "subject": {
                "principal": "bob"
              },
              "app": "*",
              "space": "",
              "policy": "orders"
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "tenant:acme": 1
    }
  }
}
