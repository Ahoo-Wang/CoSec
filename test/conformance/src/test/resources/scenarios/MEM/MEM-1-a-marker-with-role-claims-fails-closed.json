{
  "rules": [
    "MEM-1"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "The token asks for the provider and also claims roles. Anyone may read, and the provider would answer: the request fails closed.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        }
      ]
    }
  },
  "credential": {
    "membership": "provider",
    "roles": [
      "editor"
    ]
  },
  "membershipProvider": {
    "roles": {
      "": [
        "editor"
      ]
    }
  },
  "expect": {
    "decision": "Indeterminate",
    "cause": {
      "type": "MembershipUnavailable"
    }
  }
}
