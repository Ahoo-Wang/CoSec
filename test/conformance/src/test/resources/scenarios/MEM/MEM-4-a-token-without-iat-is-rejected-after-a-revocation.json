{
  "rules": [
    "MEM-4"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "A token that does not say when it was issued cannot prove it is newer than the revocation: rejected.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "p:alice:read",
            "subject": {
              "principal": "alice"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          }
        ]
      }
    }
  },
  "http": {
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": null
    }
  },
  "revocations": {
    "subjects": [
      {
        "tenant": "acme",
        "principal": "alice",
        "issuedBefore": "2026-10-02T00:00:00Z"
      }
    ]
  },
  "expect": {
    "status": 401,
    "type": "token-revoked"
  }
}
