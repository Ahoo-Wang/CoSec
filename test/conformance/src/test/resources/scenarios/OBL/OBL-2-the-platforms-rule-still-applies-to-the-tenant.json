{
  "rules": [
    "OBL-2"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The platform's api counter is exhausted; acme's own, looser api rule neither replaces nor relaxes it: acme is refused.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ],
      "rateLimits": [
        {
          "id": "api",
          "action": "*",
          "permitsPerSecond": 10
        }
      ]
    },
    "tenants": {
      "acme": {
        "policies": [],
        "bindings": [],
        "rateLimits": [
          {
            "id": "api",
            "action": "*",
            "permitsPerSecond": 1000
          }
        ]
      }
    }
  },
  "rateLimiter": {
    "exhausted": [
      "api"
    ]
  },
  "http": {
    "method": "GET",
    "path": "/orders/1"
  },
  "authentication": {
    "result": "authenticated",
    "tenant": "acme",
    "id": "alice"
  },
  "expect": {
    "status": 429,
    "type": "too-many-requests"
  }
}
