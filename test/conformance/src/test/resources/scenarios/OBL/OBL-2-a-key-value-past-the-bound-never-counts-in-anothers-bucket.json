{
  "rules": [
    "OBL-2"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "A key value that shares all but its last character with an exhausted one, both past the bound: hashing names each its own bucket, so it is not refused (DR1-C-1: a bucket is named by a hash, never by a prefix).",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "read",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET",
              "resource": "http:path:/orders/**"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:read",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "read"
        }
      ],
      "rateLimits": [
        {
          "id": "clients",
          "action": "*",
          "resource": "http:path:/orders/**",
          "permitsPerSecond": 10,
          "key": "http.header.x-client-id"
        }
      ]
    }
  },
  "rateLimiter": {
    "exhaustedKeys": {
      "platform/clients": [
        "client-ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      ]
    }
  },
  "http": {
    "path": "/orders/1",
    "headers": {
      "x-client-id": "client-ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccd"
    }
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
