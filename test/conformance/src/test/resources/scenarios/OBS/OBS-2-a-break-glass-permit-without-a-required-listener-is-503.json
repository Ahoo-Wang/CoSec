{
  "rules": [
    "OBS-2"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The root break-glass binding permits, and no REQUIRED listener is registered: its use cannot be audited, 503.",
  "documents": {
    "platform": {
      "bindings": [
        {
          "id": "root",
          "subject": {
            "principal": "cosec",
            "tenant": "(platform)"
          },
          "app": "*",
          "space": "*",
          "policy": "cosec:root",
          "breakGlass": true,
          "expiresAt": "2099-12-31T00:00:00Z"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "jwt",
    "jwt": {
      "jti": "t1",
      "sub": "cosec",
      "tenantId": "(platform)"
    }
  },
  "listeners": [
    {
      "name": "metrics",
      "delivery": "best-effort"
    }
  ],
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
