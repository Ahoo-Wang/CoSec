{
  "rules": [
    "BDY-1"
  ],
  "polarity": "negative",
  "level": "engine",
  "description": "A principal of the platform tenant is not held to the default boundary.",
  "documents": {
    "platform": {
      "boundaries": {
        "default": "orders-only"
      },
      "policies": [
        {
          "id": "all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        },
        {
          "id": "orders-only",
          "boundary": true,
          "statements": [
            {
              "effect": "allow",
              "action": "order:*"
            }
          ]
        },
        {
          "id": "anything",
          "boundary": true,
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "all"
        }
      ]
    }
  },
  "credential": {
    "tenant": "(platform)",
    "id": "ops"
  },
  "request": {
    "action": "user:read"
  },
  "expect": {
    "decision": "Permit",
    "by": {
      "policy": "all",
      "statement": 0,
      "via": {
        "binding": "g:all",
        "document": "platform"
      }
    }
  }
}
