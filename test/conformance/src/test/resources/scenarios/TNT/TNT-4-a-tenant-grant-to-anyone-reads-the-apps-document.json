{
  "rules": [
    "TNT-4"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "RC1-17: acme binds order's permission policy perm:order/no-reads, a DENY, to Anyone in order. alice has no role: the view still reads order's document, so the binding resolves and the app's DENY applies, where it was an unresolved policy (503) before.",
  "documents": {
    "apps": {
      "order": {
        "policies": [
          {
            "id": "perm:order/no-reads",
            "statements": [
              {
                "effect": "deny",
                "action": "http:GET"
              }
            ]
          },
          {
            "id": "perm:order/read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ]
      }
    },
    "tenants": {
      "acme": {
        "bindings": [
          {
            "id": "no-reads",
            "subject": "*",
            "app": "order",
            "space": "*",
            "policy": "perm:order/no-reads"
          }
        ]
      }
    },
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "token"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "app": "order"
    }
  },
  "expect": {
    "status": 403,
    "type": "forbidden"
  }
}
