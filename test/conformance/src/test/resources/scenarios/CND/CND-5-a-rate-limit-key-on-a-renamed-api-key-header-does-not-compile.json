{
  "rules": [
    "CND-5"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "RC1-21: the host reads API keys from X-Acme-Key (cosec.pipeline.api-key-header), so a rate limit rule keyed on it is refused at compile time: it would write raw keys into the counters' names.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "read",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "read",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "read"
        }
      ],
      "rateLimits": [
        {
          "id": "per-key",
          "action": "*",
          "permitsPerSecond": 10,
          "key": "http.header.x-acme-key"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders"
  },
  "options": {
    "apiKeyHeader": "X-Acme-Key"
  },
  "expect": {
    "decision": "NotCompiled",
    "error": "credential header"
  }
}
