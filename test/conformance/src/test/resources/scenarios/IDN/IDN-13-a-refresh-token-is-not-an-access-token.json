{
  "rules": [
    "IDN-13"
  ],
  "level": "pipeline",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "reads",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/orders/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "reads",
            "subject": {
              "principal": "at-1",
              "tenant": "acme"
            },
            "app": "*",
            "space": "*",
            "policy": "reads"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders/1",
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "polarity": "positive",
  "description": "A signed, unexpired refresh token, whose sub is the access token's id, is not a principal of that name, even on a host with no app and a policy bound to that id: rejected, and the request, evaluated as anonymous, is denied 401 token-invalid.",
  "authentication": {
    "result": "jwt",
    "jwt": {
      "jti": "r1",
      "sub": "at-1",
      "tenantId": "acme",
      "claims": {
        "cosec.token": "refresh"
      }
    }
  },
  "expect": {
    "status": 401,
    "type": "token-invalid"
  }
}
