{
  "rules": [
    "IDN-22"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "alice signed in 31 days ago; her session's lifetime is 30 days, so it has ended, while her access token is still unexpired: the switch to globex issues nothing, and she signs in again.",
  "switch": {
    "access": {
      "jti": "a1",
      "sub": "alice",
      "tenantId": "acme",
      "iat": 1790812800,
      "claims": {
        "sid": "f1",
        "auth_time": 1790812800,
        "cosec.generation": 1
      }
    },
    "targetTenantId": "globex",
    "answer": {
      "roles": [
        "clerk"
      ]
    }
  },
  "families": [
    {
      "id": "f1",
      "tenant": "acme",
      "principal": "alice",
      "authTime": "2026-10-01T00:00:00Z",
      "generation": 1
    }
  ],
  "expect": {
    "status": 401,
    "type": "token-expired"
  }
}
