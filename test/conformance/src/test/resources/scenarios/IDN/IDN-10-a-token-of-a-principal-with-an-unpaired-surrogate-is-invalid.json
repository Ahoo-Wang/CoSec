{
  "rules": [
    "IDN-10"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "A valid token of principal alice\\uDC00 in acme, whose memberships and revocations a Redis key would read as alice?'s, is invalid: 401 token-invalid, never alice?, whom acme lets read.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "alice-reads",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/orders/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "alice-reads",
            "subject": {
              "principal": "alice?",
              "tenant": "acme"
            },
            "app": "*",
            "space": "*",
            "policy": "alice-reads"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders/1",
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice\udc00"
    }
  },
  "expect": {
    "status": 401,
    "type": "token-invalid"
  }
}
