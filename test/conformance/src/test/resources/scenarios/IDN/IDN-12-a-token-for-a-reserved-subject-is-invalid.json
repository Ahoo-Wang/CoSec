{
  "rules": [
    "IDN-12"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "A token whose subject begins with ( names an id reserved for CoSec, such as the anonymous principal (0): it is invalid, and the request, evaluated as anonymous, is denied 401 token-invalid.",
  "documents": {
    "tenants": {
      "(0)": {
        "policies": [
          {
            "id": "alice-reads",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/orders/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "alice-reads",
            "subject": {
              "principal": "alice",
              "tenant": "(0)"
            },
            "app": "*",
            "space": "*",
            "policy": "alice-reads"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders/1",
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "jwt",
    "jwt": {
      "jti": "t1",
      "sub": "(0)",
      "tenantId": "acme"
    }
  },
  "expect": {
    "status": 401,
    "type": "token-invalid"
  }
}
