{
  "rules": [
    "IDN-2"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The principal holds billing in team-a, the cap names billing in the default space: the key holds no role in team-a, so the space is refused.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/orders/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "billing",
            "subject": {
              "role": "billing"
            },
            "app": "*",
            "space": "team-a",
            "policy": "read"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders/1",
    "headers": {
      "X-API-Key": "k-svc",
      "CoSec-Space-Id": "team-a"
    }
  },
  "authentication": {
    "result": "composite",
    "apiKeys": [
      {
        "key": "k-svc",
        "id": "svc-key",
        "principalId": "svc",
        "tenantId": "acme",
        "roles": [
          "billing"
        ]
      }
    ]
  },
  "membershipProvider": {
    "principals": [
      {
        "tenant": "acme",
        "id": "svc",
        "roles": {
          "team-a": [
            "billing"
          ]
        }
      }
    ]
  },
  "expect": {
    "status": 403,
    "type": "scope-rejected"
  }
}
