{
  "rules": [
    "IDN-8"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "forward-authorization is on and the route to lb://backend receives the identity: its backend gets the Authorization header, the API key header and the query token as the client sent them. The authorization cookie goes with them (R1-4).",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "options": {
    "apiKeyHeader": "X-Service-Key"
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "token",
      "CoSec-Identity": "eyJ2IjoxfQ",
      "X-Service-Key": "key",
      "Cookie": "AUTHORIZATION=d; lang=en"
    },
    "query": "page=2&authorization=t&%61uthorization=u",
    "cookies": {
      "authorization": "c",
      "theme": "dark"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "roles": [
        "clerk"
      ]
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": {
      "tenant": "acme",
      "sub": "alice",
      "app": "",
      "space": "",
      "jti": "t1",
      "roles": [
        "clerk"
      ]
    },
    "credentials": [
      "authorization",
      "cookie:authorization",
      "query:authorization",
      "x-service-key"
    ]
  },
  "gateway": {
    "route": {
      "uri": "lb://backend"
    },
    "forwardAuthorization": true
  }
}
