  "refresh": {
    "access": {
      "jti": "a1",
      "sub": "alice",
      "tenantId": "acme",
      "iat": 1793404800,
      "claims": {
        "sid": "f1",
        "auth_time": 1793404800,
        "cosec.generation": 1
      }
    },
    "refresh": {
      "jti": "r1",
      "sub": "a1",
      "iat": 1793404800,
      "claims": {
        "cosec.token": "refresh",
        "sid": "f1",
        "auth_time": 1793404800,
        "cosec.generation": 1
      }
    }
  },
  "revocations": {
    "unavailable": "Redis is down"
  },
  "families": [
    {
      "id": "f1",
      "tenant": "acme",
      "principal": "alice",
      "authTime": "2026-10-31T00:00:00Z",
      "generation": 1
    }
  ],
  "expect": {
