{
  "rules": [
    "IDN-8"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "RC1-5: alice sends a token in Authorization, a key in the API key header (renamed X-Service-Key) and a token in the authorization query parameter, its name once percent-encoded. forward-authorization is off: the backend of the lb:// route gets the verified identity and none of them.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "options": {
    "apiKeyHeader": "X-Service-Key"
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "token",
      "CoSec-Identity": "eyJ2IjoxfQ",
      "X-Service-Key": "key"
    },
    "query": "page=2&authorization=t&%61uthorization=u"
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "roles": [
        "clerk"
      ]
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": {
      "tenant": "acme",
      "sub": "alice",
      "app": "",
      "space": "",
      "jti": "t1",
      "roles": [
        "clerk"
      ]
    }
  },
  "gateway": {
    "route": {
      "uri": "lb://backend"
    }
  }
}
