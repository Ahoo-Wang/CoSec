{
  "rules": [
    "IDN-1"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The key names billing, but its principal holds no roles: a key's roles only narrow, so it may not read orders.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/orders/**"
              }
            ]
          },
          {
            "id": "admin",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/admin/**"
              }
            ]
          },
          {
            "id": "attached",
            "attachable": true,
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/reports/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "billing",
            "subject": {
              "role": "billing"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          },
          {
            "id": "admin",
            "subject": {
              "role": "admin"
            },
            "app": "*",
            "space": "*",
            "policy": "admin"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders/1",
    "headers": {
      "X-API-Key": "k-svc"
    }
  },
  "authentication": {
    "result": "composite",
    "apiKeys": [
      {
        "key": "k-svc",
        "id": "svc-key",
        "principalId": "svc",
        "tenantId": "acme",
        "roles": [
          "billing"
        ]
      }
    ]
  },
  "membershipProvider": {
    "principals": [
      {
        "tenant": "acme",
        "id": "svc"
      }
    ]
  },
  "expect": {
    "status": 403,
    "type": "forbidden"
  }
}
