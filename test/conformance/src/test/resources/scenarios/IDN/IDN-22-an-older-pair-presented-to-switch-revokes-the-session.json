{
  "rules": [
    "IDN-22"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "alice's session f1 was refreshed twice since the pair she presents to switch (generation 1, the session at 3): the pair is presented again, as a refresh would present it, so the session is revoked and nothing is issued.",
  "switch": {
    "access": {
      "jti": "a1",
      "sub": "alice",
      "tenantId": "acme",
      "iat": 1793404800,
      "claims": {
        "sid": "f1",
        "auth_time": 1793404800,
        "cosec.generation": 1
      }
    },
    "refresh": {
      "jti": "r-a1",
      "sub": "a1",
      "iat": 1793404800,
      "claims": {
        "cosec.token": "refresh",
        "sid": "f1",
        "auth_time": 1793404800,
        "cosec.generation": 1
      }
    },
    "targetTenantId": "globex",
    "answer": {
      "roles": [
        "clerk"
      ]
    }
  },
  "families": [
    {
      "id": "f1",
      "tenant": "acme",
      "principal": "alice",
      "authTime": "2026-10-31T00:00:00Z",
      "generation": 3
    }
  ],
  "expect": {
    "status": 401,
    "type": "token-revoked"
  }
}
