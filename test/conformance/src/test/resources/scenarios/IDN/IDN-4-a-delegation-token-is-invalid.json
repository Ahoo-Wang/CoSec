{
  "rules": [
    "IDN-4"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "A signed, unexpired token for alice that an agent acts with (act) is not alice: it is rejected, and the request, evaluated as anonymous, is denied 401 token-invalid.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "alice-reads",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/orders/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "alice-reads",
            "subject": {
              "principal": "alice",
              "tenant": "acme"
            },
            "app": "*",
            "space": "*",
            "policy": "alice-reads"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders/1",
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "jwt",
    "jwt": {
      "jti": "t1",
      "sub": "alice",
      "tenantId": "acme",
      "claims": {
        "act": {
          "sub": "agent"
        }
      }
    }
  },
  "expect": {
    "status": 401,
    "type": "token-invalid"
  }
}
