{
  "rules": [
    "IDN-8"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "forward-authorization is on and the route receives the identity, but the token has expired: the request goes on as anonymous to a public route, and none of its credentials goes with it, so a backend that verifies the token itself never sees one the gateway refused (R1A-7).",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "options": {
    "apiKeyHeader": "X-Service-Key",
    "allowCookieToken": true
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "Bearer t1",
      "X-Service-Key": "key",
      "Cookie": "AUTHORIZATION=d; lang=en"
    },
    "query": "page=2&authorization=t"
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": "2026-10-01T00:00:00Z",
      "verification": "expired"
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": null
  },
  "gateway": {
    "route": {
      "uri": "lb://backend"
    },
    "forwardAuthorization": true
  }
}
