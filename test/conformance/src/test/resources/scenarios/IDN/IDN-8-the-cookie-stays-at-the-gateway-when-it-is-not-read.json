{
  "rules": [
    "IDN-8"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "R1-4, whether or not the pipeline reads it: allow-cookie-token is off, and the authorization cookie still stays at the gateway. The backend of the lb:// route gets the verified identity, and lang and theme go on, the token in no Cookie header.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "options": {
    "apiKeyHeader": "X-Service-Key"
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "token",
      "CoSec-Identity": "eyJ2IjoxfQ",
      "X-Service-Key": "key",
      "Cookie": "AUTHORIZATION=d; lang=en"
    },
    "query": "page=2&authorization=t&%61uthorization=u",
    "cookies": {
      "authorization": "c",
      "theme": "dark"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "roles": [
        "clerk"
      ]
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": {
      "tenant": "acme",
      "sub": "alice",
      "app": "",
      "space": "",
      "jti": "t1",
      "roles": [
        "clerk"
      ]
    }
  },
  "gateway": {
    "route": {
      "uri": "lb://backend"
    }
  }
}
