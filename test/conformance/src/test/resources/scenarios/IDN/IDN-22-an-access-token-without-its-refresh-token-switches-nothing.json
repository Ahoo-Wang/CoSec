{
  "rules": [
    "IDN-22"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "alice's session f1 is live, but her switch presents her access token without its refresh token: an access token alone opens no session that refreshes, and nothing is issued.",
  "switch": {
    "access": {
      "jti": "a1",
      "sub": "alice",
      "tenantId": "acme",
      "iat": 1793404800,
      "claims": {
        "sid": "f1",
        "auth_time": 1793404800,
        "cosec.generation": 1
      }
    },
    "targetTenantId": "globex",
    "answer": {
      "roles": [
        "clerk"
      ]
    }
  },
  "families": [
    {
      "id": "f1",
      "tenant": "acme",
      "principal": "alice",
      "authTime": "2026-10-31T00:00:00Z",
      "generation": 1
    }
  ],
  "expect": {
    "status": 401,
    "type": "token-invalid"
  }
}
