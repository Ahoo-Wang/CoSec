{
  "rules": [
    "IDN-8"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "forward-authorization is on, but the route to https://partner.example does not receive the identity: it receives none of the caller's credentials either. The authorization cookie, in either case, stays at the gateway too (R1-4).",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "options": {
    "apiKeyHeader": "X-Service-Key",
    "allowCookieToken": true
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "token",
      "CoSec-Identity": "eyJ2IjoxfQ",
      "X-Service-Key": "key",
      "Cookie": "AUTHORIZATION=d; lang=en"
    },
    "query": "page=2&authorization=t&%61uthorization=u",
    "cookies": {
      "authorization": "c",
      "theme": "dark"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "roles": [
        "clerk"
      ]
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": null
  },
  "gateway": {
    "route": {
      "uri": "https://partner.example"
    },
    "forwardAuthorization": true
  }
}
