{
  "rules": [
    "IDN-7"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "RC1-49: alice is permitted on a route to https://partner.example without cosec-identity metadata, as one added at run time would be: its backend receives no identity at all, neither the verified one nor the client's.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "token",
      "CoSec-Identity": "eyJ2IjoxfQ"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "roles": [
        "clerk"
      ]
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": null
  },
  "gateway": {
    "route": {
      "uri": "https://partner.example"
    }
  }
}
