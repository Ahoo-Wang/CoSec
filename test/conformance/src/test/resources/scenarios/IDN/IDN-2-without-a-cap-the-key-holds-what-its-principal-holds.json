{
  "rules": [
    "IDN-2"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "A key without a cap narrows nothing: it reaches the admin pages and the reports its principal may reach.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/orders/**"
              }
            ]
          },
          {
            "id": "admin",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/admin/**"
              }
            ]
          },
          {
            "id": "attached",
            "attachable": true,
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET",
                "resource": "http:path:/reports/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "billing",
            "subject": {
              "role": "billing"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          },
          {
            "id": "admin",
            "subject": {
              "role": "admin"
            },
            "app": "*",
            "space": "*",
            "policy": "admin"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/reports/q3",
    "headers": {
      "X-API-Key": "k-svc"
    }
  },
  "authentication": {
    "result": "composite",
    "apiKeys": [
      {
        "key": "k-svc",
        "id": "svc-key",
        "principalId": "svc",
        "tenantId": "acme"
      }
    ]
  },
  "membershipProvider": {
    "principals": [
      {
        "tenant": "acme",
        "id": "svc",
        "roles": {
          "": [
            "billing",
            "admin"
          ]
        },
        "attachments": [
          "attached"
        ]
      }
    ]
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
