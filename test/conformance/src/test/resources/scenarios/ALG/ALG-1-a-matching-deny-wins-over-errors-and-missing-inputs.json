{
  "rules": [
    "ALG-1"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "One DENY matches while another DENY fails, an attachment is missing and the tenant document is unavailable: the matching DENY decides.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        },
        {
          "id": "broken",
          "statements": [
            {
              "effect": "deny",
              "action": "*",
              "fault": "the input of this DENY cannot be read"
            }
          ]
        },
        {
          "id": "deny-read",
          "statements": [
            {
              "effect": "deny",
              "action": "order:read"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        },
        {
          "id": "g:broken",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "broken"
        },
        {
          "id": "g:deny-read",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "deny-read"
        }
      ]
    },
    "unavailable": [
      "tenant"
    ]
  },
  "credential": {
    "policies": [
      "ghost"
    ]
  },
  "expect": {
    "decision": "Deny",
    "by": {
      "policy": "deny-read",
      "statement": 0,
      "via": {
        "binding": "g:deny-read",
        "document": "platform"
      }
    }
  }
}
