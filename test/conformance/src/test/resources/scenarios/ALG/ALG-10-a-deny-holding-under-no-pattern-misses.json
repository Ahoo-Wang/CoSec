{
  "rules": [
    "ALG-10"
  ],
  "polarity": "negative",
  "level": "engine",
  "description": "The near miss: GET /c/b matches only /{v}/b, with v = c; the condition holds under no pattern and the ALLOW permits.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        },
        {
          "id": "no-a",
          "statements": [
            {
              "effect": "deny",
              "action": "http:GET",
              "resource": [
                "http:path:/a/{v}",
                "http:path:/{v}/b"
              ],
              "condition": {
                "eq": [
                  "resource.var.v",
                  "a"
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        },
        {
          "id": "g:no-a",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-a"
        }
      ]
    }
  },
  "request": {
    "action": "http:GET",
    "resource": {
      "type": "http",
      "id": "/c/b"
    }
  },
  "expect": {
    "decision": "Permit",
    "by": {
      "policy": "allow-all",
      "statement": 0,
      "via": {
        "binding": "g:allow-all",
        "document": "platform"
      }
    }
  }
}
