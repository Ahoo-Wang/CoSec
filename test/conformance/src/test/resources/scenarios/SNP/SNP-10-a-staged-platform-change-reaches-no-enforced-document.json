{
  "rules": [
    "SNP-10"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The platform candidate stops declaring an attribute a tenant document reads. It is only staged: compiled for the comparison, it leaves what the instance enforces as it was, and the tenant is decided.",
  "documents": {
    "platform": {
      "attributes": [
        {
          "path": "ext.geo.inFence",
          "type": "bool"
        }
      ],
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    },
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "fence",
            "statements": [
              {
                "effect": "deny",
                "action": "http:POST",
                "condition": {
                  "eq": [
                    "ext.geo.inFence",
                    true
                  ]
                }
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "fence",
            "subject": "*",
            "app": "*",
            "space": "*",
            "policy": "fence"
          }
        ]
      }
    }
  },
  "snapshot": {
    "platformChange": {
      "staged": {
        "policies": [
          {
            "id": "open",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "open",
            "subject": "*",
            "app": "*",
            "space": "*",
            "policy": "open"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders"
  },
  "authentication": {
    "result": "authenticated",
    "tenant": "acme"
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
