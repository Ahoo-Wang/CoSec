{
  "rules": [
    "PIP-3"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "Nobody cancels, but the authenticator outlasts the pipeline's deadline: that is not a cancellation, it is 503.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "hangs"
  },
  "options": {
    "timeoutMillis": 100,
    "authenticationTimeoutMillis": 10000
  },
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
