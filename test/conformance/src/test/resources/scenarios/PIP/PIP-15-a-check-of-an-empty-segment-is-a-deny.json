{
  "rules": [
    "PIP-15"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "What enforcement answers 400 for (PIP-14) a check does not permit.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "no-admin",
          "statements": [
            {
              "effect": "deny",
              "action": "http:*",
              "resource": "http:path:/admin/{*rest}"
            }
          ]
        },
        {
          "id": "public",
          "statements": [
            {
              "effect": "allow",
              "action": "http:*",
              "resource": "http:path:/public/{*rest}"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "no-admin",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-admin"
        },
        {
          "id": "public",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "public"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/public/a"
  },
  "authentication": {
    "result": "anonymous"
  },
  "check": {
    "action": "http:GET",
    "resource": "/public//a"
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "check": "Deny"
  }
}
