{
  "rules": [
    "PIP-30"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "Decoding is single: %2500 decodes to the text %00, not to NUL, so the path is decided.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "no-admin",
          "statements": [
            {
              "effect": "deny",
              "action": "http:*",
              "resource": "http:path:/admin/**"
            }
          ]
        },
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "no-admin",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-admin"
        },
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders/a%2500b"
  },
  "authentication": {
    "result": "anonymous"
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
