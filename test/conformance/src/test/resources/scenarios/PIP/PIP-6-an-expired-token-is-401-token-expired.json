{
  "rules": [
    "PIP-6"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "alice's token has expired: the request is evaluated as anonymous, nothing permits it, and the deny says the token expired.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "p:alice:read",
            "subject": {
              "principal": "alice"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          }
        ]
      }
    }
  },
  "http": {
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": "2026-10-01T00:00:00Z",
      "verification": "expired"
    }
  },
  "expect": {
    "status": 401,
    "type": "token-expired"
  }
}
