{
  "rules": [
    "PIP-13"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "The same request with cosec.pipeline.allow-cookie-token on: the cookie is the token, and alice's binding permits.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "p:alice:read",
            "subject": {
              "principal": "alice"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          }
        ]
      }
    }
  },
  "options": {
    "allowCookieToken": true
  },
  "http": {
    "cookies": {
      "authorization": "t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": "2026-10-01T00:00:00Z"
    }
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
