{
  "rules": [
    "PIP-17"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The adapter could not read the client address (a trusted proxy wrote unknown): a DENY on environment.ip cannot be decided, 503, never skipped.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:*",
              "resource": "http:path:/**"
            }
          ]
        },
        {
          "id": "blocked-range",
          "statements": [
            {
              "effect": "deny",
              "action": "*",
              "resource": "http:path:/**",
              "condition": {
                "cidr": [
                  "environment.ip",
                  [
                    "192.0.2.0/24"
                  ]
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        },
        {
          "id": "g:blocked-range",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "blocked-range"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders",
    "remoteAddress": "unknown"
  },
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
