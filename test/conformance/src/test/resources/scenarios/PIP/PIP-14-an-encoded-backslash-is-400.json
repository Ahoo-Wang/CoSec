{
  "rules": [
    "PIP-14"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "A pattern reads admin%5Cx as one segment; a backend that decodes it and reads \\ as / serves /admin/x.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "no-admin",
          "statements": [
            {
              "effect": "deny",
              "action": "http:*",
              "resource": "http:path:/admin/*"
            }
          ]
        },
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "no-admin",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-admin"
        },
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/admin%5Cx"
  },
  "authentication": {
    "result": "anonymous"
  },
  "expect": {
    "status": 400,
    "type": "invalid-request"
  }
}
