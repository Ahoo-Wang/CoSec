{
  "rules": [
    "PIP-35"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "A DENY on DELETE /orders/{id} beside an ALLOW on /orders/**: DELETE /orders/123/ is denied, as a backend that reads it as /orders/123 would serve it.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:*",
              "resource": "http:path:/**"
            }
          ]
        },
        {
          "id": "no-delete",
          "statements": [
            {
              "effect": "deny",
              "action": "http:DELETE",
              "resource": "http:path:/orders/{id}"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        },
        {
          "id": "g:no-delete",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-delete"
        }
      ]
    }
  },
  "http": {
    "method": "DELETE",
    "path": "/orders/123/"
  },
  "expect": {
    "status": 403,
    "type": "forbidden"
  }
}
