{
  "rules": [
    "PIP-5"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "Dots that do not make a whole segment, and a segment of 256 characters, are an ordinary path.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
