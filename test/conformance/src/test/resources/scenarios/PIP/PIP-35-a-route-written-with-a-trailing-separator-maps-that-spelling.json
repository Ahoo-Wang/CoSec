{
  "rules": [
    "PIP-35"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "On a host with a route map whose route is written GET /orders/, GET /orders/ maps to it as written: the DENY on order:list decides it, and the mirror check refuses nothing that maps.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:*",
              "resource": "http:path:/**"
            }
          ]
        },
        {
          "id": "no-list",
          "statements": [
            {
              "effect": "deny",
              "action": "order:list",
              "resource": "order/*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        },
        {
          "id": "g:no-list",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-list"
        }
      ]
    }
  },
  "routes": {
    "service": "order",
    "routes": [
      {
        "method": "GET",
        "path": "/orders/",
        "action": "order:list",
        "resource": "order/all"
      }
    ]
  },
  "http": {
    "method": "GET",
    "path": "/orders/"
  },
  "expect": {
    "status": 403,
    "type": "forbidden"
  }
}
