{
  "rules": [
    "PIP-18"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "delete is no method a client sends on purpose, and a backend that folds case serves it as DELETE past the DENY on http:DELETE: 400 before authentication.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:*",
              "resource": "http:path:/**"
            }
          ]
        },
        {
          "id": "no-delete",
          "statements": [
            {
              "effect": "deny",
              "action": "http:DELETE",
              "resource": "http:path:/orders/**"
            }
          ]
        },
        {
          "id": "no-read",
          "statements": [
            {
              "effect": "deny",
              "action": "http:GET",
              "resource": "http:path:/salaries/**"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        },
        {
          "id": "g:no-delete",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-delete"
        },
        {
          "id": "g:no-read",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-read"
        }
      ]
    }
  },
  "http": {
    "method": "delete",
    "path": "/orders/1"
  },
  "expect": {
    "status": 400,
    "type": "invalid-request"
  }
}
