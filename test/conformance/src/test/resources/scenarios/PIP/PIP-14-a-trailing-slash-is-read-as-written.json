{
  "rules": [
    "PIP-14"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "A trailing separator is no empty segment before the end: the path is decided, never refused 400; an ALLOW reads it as written (PIP-35 gives the DENYs both spellings).",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET",
              "resource": "http:path:/admin/x/"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/admin/x/"
  },
  "authentication": {
    "result": "anonymous"
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
