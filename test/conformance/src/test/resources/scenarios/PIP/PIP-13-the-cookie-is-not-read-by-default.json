{
  "rules": [
    "PIP-13"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The only credential is the authorization cookie, and nothing turned the option on: a browser sends a cookie on its own, so it is no credential. The token is never verified, and the request, anonymous, is denied: 401 unauthorized, where alice's binding would permit.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "p:alice:read",
            "subject": {
              "principal": "alice"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          }
        ]
      }
    }
  },
  "http": {
    "cookies": {
      "authorization": "t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": "2026-10-01T00:00:00Z"
    }
  },
  "expect": {
    "status": 401,
    "type": "unauthorized"
  }
}
