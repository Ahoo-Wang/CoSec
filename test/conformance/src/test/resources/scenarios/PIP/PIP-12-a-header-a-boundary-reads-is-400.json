{
  "rules": [
    "PIP-12"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The platform's default boundary reads X-Zone. Sent twice with different values, the request is answered 400 before the boundary could pass or refuse it on one of them (review L2 of #1200).",
  "documents": {
    "platform": {
      "boundaries": {
        "default": "zoned"
      },
      "policies": [
        {
          "id": "all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        },
        {
          "id": "zoned",
          "boundary": true,
          "statements": [
            {
              "effect": "allow",
              "action": "*",
              "condition": {
                "eq": [
                  "http.header.x-zone",
                  "eu"
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "all"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "X-Zone": [
        "eu",
        "us"
      ]
    }
  },
  "authentication": {
    "result": "authenticated"
  },
  "expect": {
    "status": 400,
    "type": "invalid-request"
  }
}
