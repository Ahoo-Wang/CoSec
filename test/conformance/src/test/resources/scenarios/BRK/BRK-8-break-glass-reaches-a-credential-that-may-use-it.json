{
  "rules": [
    "BRK-8"
  ],
  "polarity": "negative",
  "level": "engine",
  "description": "The same root binding reaches a credential that may use break-glass (a token).",
  "documents": {
    "platform": {
      "bindings": [
        {
          "id": "root",
          "subject": {
            "principal": "cosec",
            "tenant": "(platform)"
          },
          "app": "*",
          "space": "*",
          "policy": "cosec:root",
          "breakGlass": true,
          "expiresAt": "2026-12-31T00:00:00Z"
        }
      ]
    }
  },
  "credential": {
    "tenant": "(platform)",
    "id": "cosec"
  },
  "expect": {
    "decision": "Permit",
    "by": {
      "policy": "cosec:root",
      "statement": 0,
      "name": "root",
      "via": {
        "binding": "root",
        "document": "platform"
      }
    }
  }
}
