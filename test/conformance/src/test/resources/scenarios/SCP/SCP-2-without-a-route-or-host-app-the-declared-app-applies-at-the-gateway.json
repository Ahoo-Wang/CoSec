{
  "rules": [
    "SCP-2"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "Neither the route nor the gateway names an app: alice's declared app, shop, applies, and billing's document is never read.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    },
    "apps": {
      "billing": {
        "policies": [
          {
            "id": "perm:billing/no-reads",
            "statements": [
              {
                "effect": "deny",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "r:clerk",
            "subject": {
              "role": "clerk"
            },
            "app": "billing",
            "space": "*",
            "policy": "perm:billing/no-reads"
          }
        ]
      }
    }
  },
  "http": {
    "method": "GET",
    "path": "/invoices",
    "headers": {
      "Authorization": "token",
      "CoSec-App-Id": "shop"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "roles": [
        "clerk"
      ]
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": null
  },
  "gateway": {
    "route": {
      "uri": "lb://billing"
    }
  }
}
