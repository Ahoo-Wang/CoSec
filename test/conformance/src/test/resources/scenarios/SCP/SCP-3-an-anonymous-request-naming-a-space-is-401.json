{
  "rules": [
    "SCP-3"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "An anonymous request declares CoSec-Space-Id: it has no memberships, so the scope is rejected and the answer is 401, although everyone may read.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "anonymous"
  },
  "http": {
    "headers": {
      "CoSec-Space-Id": "team-a"
    }
  },
  "expect": {
    "status": 401,
    "type": "unauthorized"
  }
}
