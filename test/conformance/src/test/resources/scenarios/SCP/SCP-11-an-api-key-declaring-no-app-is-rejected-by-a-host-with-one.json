        "key": "k-svc",
        "id": "svc-key",
        "principalId": "svc",
        "tenantId": "acme",
        "roles": [
          "billing"
        ]
      }
    ]
  },
  "membershipProvider": {
    "principals": [
      {
        "tenant": "acme",
        "id": "svc",
        "roles": {
          "": [
            "billing"
          ]
        },
        "attachments": [
          "no-export"
        ]
      }
    ]
  },
  "expect": {
