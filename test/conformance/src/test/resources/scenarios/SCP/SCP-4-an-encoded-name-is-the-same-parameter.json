{
  "rules": [
    "SCP-4"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "%43oSec-App-Id decodes to CoSec-App-Id, so it disagrees with the header: 400.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "anonymous"
  },
  "http": {
    "query": "%43oSec-App-Id=other",
    "headers": {
      "cosec-app-id": "shop"
    }
  },
  "expect": {
    "status": 400,
    "type": "invalid-request"
  }
}
