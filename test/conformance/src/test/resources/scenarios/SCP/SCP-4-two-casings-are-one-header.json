{
  "rules": [
    "SCP-4"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "Header names ignore case, so cosec-device-id and CoSec-Device-Id are one parameter with two values: 400.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "anonymous"
  },
  "http": {
    "headers": {
      "cosec-device-id": "shop",
      "CoSec-Device-Id": "other"
    }
  },
  "expect": {
    "status": 400,
    "type": "invalid-request"
  }
}
