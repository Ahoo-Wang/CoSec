{
  "rules": [
    "SCP-4"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "CoSec-App-Id is shop in both places: one value, and the request is permitted.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "anonymous"
  },
  "http": {
    "query": "CoSec-App-Id=shop",
    "headers": {
      "CoSec-App-Id": "shop"
    }
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
