{
  "rules": [
    "SCP-4"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "CoSec-App-Id is shop in the header and other in the query: the request cannot be read unambiguously, 400 before authentication.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "anonymous"
  },
  "http": {
    "query": "CoSec-App-Id=other",
    "headers": {
      "CoSec-App-Id": "shop"
    }
  },
  "expect": {
    "status": 400,
    "type": "invalid-request"
  }
}
