{
  "rules": [
    "SCP-11"
  ],
  "polarity": "negative",
  "level": "engine",
  "description": "RFC 0012 §3.5: an anonymous request has no credential, so its app is the host's: it is not rejected for declaring none.",
  "documents": {
    "apps": {
      "order-service": {
        "policies": [
          {
            "id": "perm:order-service/perm-order-service",
            "statements": [
              {
                "effect": "allow",
                "action": "*"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "r:order-service",
            "subject": {
              "role": "editor"
            },
            "app": "order-service",
            "space": "*",
            "policy": "perm:order-service/perm-order-service"
          }
        ]
      }
    }
  },
  "credential": {
    "anonymous": true
  },
  "request": {
    "hostApp": "order-service"
  },
  "expect": {
    "decision": "Deny",
    "by": null
  }
}
