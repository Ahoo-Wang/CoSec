{
  "rules": [
    "SCP-4"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "CoSec-Space-Id is sent twice in the query, a space and empty: every value is ASCII whitespace, so the parameter reads as not sent, and the anonymous request is in the default space.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "anonymous"
  },
  "http": {
    "query": "CoSec-Space-Id=%20&CoSec-Space-Id="
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
