{
  "rules": [
    "ROL-12"
  ],
  "polarity": "negative",
  "level": "control",
  "description": "App wms defines the system role clerk. A change to app ops that defines a system role auditor, which no other app defines, is checked without a warning.",
  "documents": {
    "platform": {},
    "apps": {
      "wms": {
        "catalog": {
          "groups": [
            {
              "name": "all",
              "permissions": [
                {
                  "id": "read",
                  "action": "wms:read"
                }
              ]
            }
          ]
        },
        "roles": [
          {
            "id": "clerk",
            "permissions": "*"
          }
        ]
      },
      "ops": {
        "catalog": {
          "groups": [
            {
              "name": "all",
              "permissions": [
                {
                  "id": "read",
                  "action": "ops:read"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "steps": [
    {
      "propose": {
        "change": "c1",
        "document": "app:ops",
        "operations": [
          {
            "putRole": {
              "id": "auditor",
              "permissions": [
                "read"
              ]
            }
          }
        ]
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "app:ops": 1
    }
  }
}
