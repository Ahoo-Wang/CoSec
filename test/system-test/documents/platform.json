{
  "schema": 2,
  "revision": 1,
  "publishedAt": "2026-11-18T00:00:00Z",
  "policies": [
    {
      "id": "public",
      "statements": [{ "effect": "allow", "action": "http:GET", "resource": "http:path:/behind/public/**" }]
    },
    {
      "id": "members",
      "statements": [{ "effect": "allow", "action": "http:*", "condition": { "eq": ["subject.authenticated", true] } }]
    },
    {
      "id": "no-denied",
      "statements": [{ "effect": "deny", "action": "http:*", "resource": "http:path:/behind/denied/**" }]
    }
  ],
  "bindings": [
    { "id": "public", "subject": "*", "app": "*", "space": "*", "policy": "public" },
    { "id": "members", "subject": "*", "app": "*", "space": "*", "policy": "members" },
    { "id": "no-denied", "subject": "*", "app": "*", "space": "*", "policy": "no-denied" }
  ]
}
