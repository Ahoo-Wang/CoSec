{
  "schema": 2,
  "revision": 1,
  "publishedAt": "2026-11-18T00:00:00Z",
  "policies": [
    {
      "id": "public",
      "statements": [
        {
          "name": "public-pages",
          "effect": "allow",
          "action": "http:GET",
          "resource": "http:path:/behind/public/**"
        },
        {
          "name": "health",
          "effect": "allow",
          "action": "http:GET",
          "resource": "http:path:/actuator/health/**"
        },
        {
          "name": "sign-in",
          "effect": "allow",
          "action": "http:POST",
          "resource": [
            "http:path:/auth/login",
            "http:path:/auth/refresh",
            "http:path:/auth/logout"
          ]
        }
      ]
    },
    {
      "id": "members",
      "statements": [
        {
          "name": "orders",
          "effect": "allow",
          "action": "http:*",
          "resource": [
            "http:path:/behind/orders/**",
            "http:path:/plain/**",
            "http:path:/orders/**"
          ],
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    },
    {
      "id": "control-api",
      "statements": [
        {
          "name": "reach-the-control-api",
          "effect": "allow",
          "action": [
            "http:GET",
            "http:POST",
            "http:DELETE"
          ],
          "resource": "http:path:/cosec/control/v1/**",
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    },
    {
      "id": "no-denied",
      "statements": [
        {
          "name": "denied",
          "effect": "deny",
          "action": "http:*",
          "resource": [
            "http:path:/behind/denied/**",
            "http:path:/denied/**"
          ]
        }
      ]
    },
    {
      "id": "admin",
      "statements": [
        {
          "name": "root-administers",
          "effect": "allow",
          "action": [
            "http:POST",
            "http:DELETE"
          ],
          "resource": "http:path:/admin/**",
          "condition": {
            "and": [
              {
                "eq": [
                  "subject.authenticated",
                  true
                ]
              },
              {
                "eq": [
                  "subject.id",
                  "root"
                ]
              },
              {
                "eq": [
                  "subject.tenant",
                  "(platform)"
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "bindings": [
    {
      "id": "public",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "public"
    },
    {
      "id": "members",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "members"
    },
    {
      "id": "control-api",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "control-api"
    },
    {
      "id": "no-denied",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "no-denied"
    },
    {
      "id": "admin",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "admin"
    }
  ]
}
