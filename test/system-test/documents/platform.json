{
  "schema": 2,
  "revision": 1,
  "publishedAt": "2026-11-18T00:00:00Z",
  "policies": [
    {
      "id": "public",
      "statements": [
        {
          "name": "public-pages",
          "effect": "allow",
          "action": "http:GET",
          "resource": "http:path:/behind/public/**"
        },
        {
          "name": "health",
          "effect": "allow",
          "action": "http:GET",
          "resource": "http:path:/actuator/health/**"
        },
        {
          "name": "sign-in",
          "effect": "allow",
          "action": "http:POST",
          "resource": [
            "http:path:/auth/login",
            "http:path:/auth/refresh",
            "http:path:/auth/logout"
          ]
        }
      ]
    },
    {
      "id": "members",
      "statements": [
        {
          "name": "orders",
          "effect": "allow",
          "action": "http:*",
          "resource": [
            "http:path:/behind/orders/**",
            "http:path:/plain/**",
            "http:path:/orders/**"
          ],
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    },
    {
      "id": "control-api",
      "statements": [
        {
          "name": "reach-the-control-api",
          "effect": "allow",
          "action": [
            "http:GET",
            "http:POST",
            "http:DELETE"
          ],
          "resource": "http:path:/cosec/control/v1/**",
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    },
    {
      "id": "no-denied",
      "statements": [
        {
          "name": "denied",
          "effect": "deny",
          "action": "http:*",
          "resource": [
            "http:path:/behind/denied/**",
            "http:path:/denied/**"
          ]
        }
      ]
    },
    {
      "id": "admin",
      "statements": [
        {
          "name": "root-administers",
          "effect": "allow",
          "action": [
            "http:POST",
            "http:DELETE"
          ],
          "resource": "http:path:/admin/**",
          "condition": {
            "and": [
              {
                "eq": [
                  "subject.authenticated",
                  true
                ]
              },
              {
                "eq": [
                  "subject.id",
                  "root"
                ]
              },
              {
                "eq": [
                  "subject.tenant",
                  "(platform)"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-service",
      "statements": [
        {
          "name": "tenant-documents",
          "effect": "allow",
          "action": [
            "cosec:read",
            "cosec:shadow-read",
            "cosec:write",
            "cosec:publish",
            "cosec:skip-shadow",
            "cosec:manage-roles"
          ],
          "resource": "doc/tenant/**"
        },
        {
          "name": "app-documents-to-read",
          "effect": "allow",
          "action": "cosec:read",
          "resource": "doc/app/**"
        },
        {
          "name": "bindings-in-tenants",
          "effect": "allow",
          "action": "cosec:grant",
          "resource": "scope/**"
        }
      ]
    },
    {
      "id": "control-reader",
      "statements": [
        {
          "name": "read-documents",
          "effect": "allow",
          "action": "cosec:read",
          "resource": [
            "doc/tenant/**",
            "doc/app/**"
          ]
        }
      ]
    }
  ],
  "bindings": [
    {
      "id": "public",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "public"
    },
    {
      "id": "members",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "members"
    },
    {
      "id": "control-api",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "control-api"
    },
    {
      "id": "no-denied",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "no-denied"
    },
    {
      "id": "admin",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "admin"
    },
    {
      "id": "svc-iam",
      "subject": {
        "principal": "svc-iam",
        "tenant": "(platform)"
      },
      "app": "cosec-control",
      "space": "",
      "policy": "control-service"
    },
    {
      "id": "svc-reports",
      "subject": {
        "principal": "svc-reports",
        "tenant": "(platform)"
      },
      "app": "cosec-control",
      "space": "",
      "policy": "control-reader"
    }
  ]
}
