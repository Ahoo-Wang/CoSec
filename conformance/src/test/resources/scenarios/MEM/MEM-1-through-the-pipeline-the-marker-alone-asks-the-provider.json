{
  "rules": [
    "MEM-1"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "The token carries the provider marker and no claims: the provider answers and alice's binding permits.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "p:alice:read",
            "subject": {
              "principal": "alice"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          }
        ]
      }
    }
  },
  "http": {
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": "2026-10-01T00:00:00Z",
      "membership": "provider"
    }
  },
  "membershipProvider": {
    "roles": {}
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
