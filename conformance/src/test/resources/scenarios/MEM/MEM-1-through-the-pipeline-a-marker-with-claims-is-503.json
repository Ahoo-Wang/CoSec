{
  "rules": [
    "MEM-1"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The token asks for the provider and also claims roles: the memberships are unusable, 503, and the provider's answer is never read.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "p:alice:read",
            "subject": {
              "principal": "alice"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          }
        ]
      }
    }
  },
  "http": {
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": "2026-10-01T00:00:00Z",
      "membership": "provider",
      "roles": [
        "admin"
      ]
    }
  },
  "membershipProvider": {
    "roles": {
      "": [
        "admin"
      ]
    }
  },
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
