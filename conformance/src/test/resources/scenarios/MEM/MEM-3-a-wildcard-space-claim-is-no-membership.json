{
  "rules": [
    "MEM-3"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "The principal claims editor@* and declares team-a: * is not a space, so it is a member of none.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "allow-all",
            "statements": [
              {
                "effect": "allow",
                "action": "*"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "r:editor:allow-all",
            "subject": {
              "role": "editor"
            },
            "app": "*",
            "space": "*",
            "policy": "allow-all"
          }
        ]
      }
    }
  },
  "credential": {
    "roles": [
      "editor@*"
    ]
  },
  "request": {
    "space": "team-a"
  },
  "expect": {
    "decision": "Rejected",
    "reason": "SPACE_NOT_MEMBER"
  }
}
