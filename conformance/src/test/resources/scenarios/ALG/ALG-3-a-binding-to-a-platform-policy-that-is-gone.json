    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        }
      ]
    },
    "tenants": {
