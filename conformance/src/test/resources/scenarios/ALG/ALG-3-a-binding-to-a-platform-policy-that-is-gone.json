        "bindings": [
          {
            "id": "g:shared",
            "subject": "*",
            "app": "*",
            "space": "*",
            "policy": "shared"
          }
        ]
      }
    }
  },
  "expect": {
    "decision": "Indeterminate",
    "cause": {
      "type": "MissingPolicies",
      "policies": [
        "shared"
      ]
    }
  }
