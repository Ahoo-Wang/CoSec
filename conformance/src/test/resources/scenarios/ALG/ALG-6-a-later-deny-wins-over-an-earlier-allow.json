{
  "rules": [
    "ALG-6"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "The platform ALLOW comes first in candidate order, the role DENY of the app document last: the DENY decides all the same.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        }
      ]
    },
    "apps": {
      "order-service": {
        "policies": [
          {
            "id": "perm:order-service/perm-deny",
            "statements": [
              {
                "effect": "deny",
                "action": "order:read"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "r:editor:perm-deny",
            "subject": {
              "role": "editor"
            },
            "app": "order-service",
            "space": "*",
            "policy": "perm:order-service/perm-deny"
          }
        ]
      }
    }
  },
  "credential": {
    "roles": [
      "editor"
    ]
  },
  "request": {
    "app": "order-service"
  },
  "expect": {
    "decision": "Deny",
    "by": {
      "policy": "perm:order-service/perm-deny",
      "statement": 0,
      "via": {
        "binding": "r:editor:perm-deny",
        "document": "app"
      }
    }
  }
}
