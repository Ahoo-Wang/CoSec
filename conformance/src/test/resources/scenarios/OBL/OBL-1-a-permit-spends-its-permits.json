{
  "rules": [
    "OBL-1"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "The same request permitted: its obligation runs and meets the exhausted bucket.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "read",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET",
              "resource": "http:path:/orders/**"
            }
          ]
        },
        {
          "id": "no-delete",
          "statements": [
            {
              "effect": "deny",
              "action": "http:DELETE",
              "resource": "http:path:/orders/**"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:read",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "read"
        },
        {
          "id": "g:no-delete",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-delete"
        }
      ],
      "rateLimits": [
        {
          "id": "orders",
          "action": "*",
          "resource": "http:path:/orders/**",
          "permitsPerSecond": 10
        }
      ]
    }
  },
  "rateLimiter": {
    "exhausted": [
      "orders"
    ]
  },
  "http": {
    "path": "/orders/1"
  },
  "expect": {
    "status": 429,
    "type": "too-many-requests"
  }
}
