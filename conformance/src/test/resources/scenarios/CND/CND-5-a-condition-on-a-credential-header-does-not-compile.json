{
  "rules": [
    "CND-5"
  ],
  "polarity": "positive",
  "level": "engine",
  "description": "A DENY that reads the Authorization header, in any case, is refused at compile time: its decisions would reveal the token.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "guarded",
          "statements": [
            {
              "effect": "deny",
              "action": "*",
              "condition": {
                "prefix": [
                  "http.header.Authorization",
                  "Bearer a"
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "guarded",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "guarded"
        }
      ]
    }
  },
  "request": {},
  "expect": {
    "decision": "NotCompiled",
    "error": "credential header"
  }
}
