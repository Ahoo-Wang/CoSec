{
  "rules": [
    "CTL-3"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "Simulate reads the request's headers as enforcement does: the platform's DENY on X-Trace decides a request that sends it, and a candidate adding a DENY on X-Debug shows its impact on a request that sends it, not on one that does not.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "no-delete",
          "statements": [
            {
              "effect": "deny",
              "action": "order:delete",
              "resource": "order/**"
            }
          ]
        },
        {
          "id": "no-trace",
          "statements": [
            {
              "effect": "deny",
              "action": "order:read",
              "condition": {
                "eq": [
                  "http.header.x-trace",
                  "on"
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "plato",
          "subject": {
            "principal": "plato",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        },
        {
          "id": "no-delete",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-delete"
        },
        {
          "id": "no-trace",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-trace"
        }
      ]
    },
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "orders",
            "statements": [
              {
                "effect": "allow",
                "action": "order:*",
                "resource": "order/**"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "admins",
            "subject": {
              "role": "admin"
            },
            "app": "cosec-control",
            "space": "",
            "policy": "cosec:tenant-admin"
          },
          {
            "id": "ops",
            "subject": {
              "role": "ops"
            },
            "app": "order",
            "space": "*",
            "policy": "orders"
          }
        ]
      }
    }
  },
  "operators": {
    "alice": {
      "tenant": "acme",
      "roles": [
        "admin",
        "ops@team-a"
      ]
    },
    "plato": {
      "tenant": "(platform)"
    }
  },
  "steps": [
    {
      "simulate": {
        "by": "plato",
        "request": {
          "tenant": "acme",
          "principal": "bob",
          "roles": [
            "ops@team-a"
          ],
          "app": "order",
          "space": "team-a",
          "action": "order:read",
          "resource": "order/1",
          "headers": {
            "X-Trace": "on"
          }
        }
      }
    },
    {
      "simulate": {
        "by": "plato",
        "request": {
          "tenant": "acme",
          "principal": "bob",
          "roles": [
            "ops@team-a"
          ],
          "app": "order",
          "space": "team-a",
          "action": "order:read",
          "resource": "order/1",
          "headers": {
            "X-Trace": "off"
          }
        }
      }
    },
    {
      "propose": {
        "change": "c1",
        "by": "alice",
        "document": "tenant:acme",
        "operations": [
          {
            "putPolicy": {
              "id": "no-debug",
              "statements": [
                {
                  "effect": "deny",
                  "action": "order:read",
                  "condition": {
                    "eq": [
                      "http.header.x-debug",
                      "1"
                    ]
                  }
                }
              ]
            }
          },
          {
            "putBinding": {
              "id": "no-debug",
              "subject": "*",
              "app": "*",
              "space": "*",
              "policy": "no-debug"
            }
          }
        ]
      }
    },
    {
      "simulate": {
        "by": "alice",
        "request": {
          "tenant": "acme",
          "principal": "bob",
          "roles": [
            "ops@team-a"
          ],
          "app": "order",
          "space": "team-a",
          "action": "order:read",
          "resource": "order/1",
          "headers": {
            "X-Debug": "1"
          }
        },
        "candidate": "c1"
      }
    },
    {
      "simulate": {
        "by": "alice",
        "request": {
          "tenant": "acme",
          "principal": "bob",
          "roles": [
            "ops@team-a"
          ],
          "app": "order",
          "space": "team-a",
          "action": "order:read",
          "resource": "order/1",
          "headers": {
            "X-Debug": "0"
          }
        },
        "candidate": "c1"
      }
    }
  ],
  "expect": {
    "steps": [
      "Deny by no-trace",
      "Permit by orders",
      "CHECKED",
      "Permit by orders; candidate Deny by no-debug",
      "Permit by orders; candidate Permit by orders"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "tenant:acme": 1
    }
  }
}
