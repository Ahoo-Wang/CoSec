{
  "rules": [
    "PIP-7"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The revocation check reports an error instead of degrading: alice's token cannot be shown not revoked, so the request is 503, never permitted.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "read",
            "statements": [
              {
                "effect": "allow",
                "action": "http:GET"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "p:alice:read",
            "subject": {
              "principal": "alice"
            },
            "app": "*",
            "space": "*",
            "policy": "read"
          }
        ]
      }
    }
  },
  "http": {
    "headers": {
      "Authorization": "Bearer t1"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "issuedAt": "2026-10-01T00:00:00Z"
    }
  },
  "revocations": {
    "fails": "unreadable revocation"
  },
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
