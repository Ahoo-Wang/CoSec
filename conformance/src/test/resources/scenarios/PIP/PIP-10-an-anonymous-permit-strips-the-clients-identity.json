{
  "rules": [
    "PIP-10"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "An anonymous request with a CoSec-Identity of its own is permitted: the gateway forwards no identity, so the header is stripped. Through the gateway host's filters: the strip, the pipeline's filter and the last hop.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "CoSec-Identity": "eyJ2IjoxfQ"
    }
  },
  "authentication": {
    "result": "anonymous"
  },
