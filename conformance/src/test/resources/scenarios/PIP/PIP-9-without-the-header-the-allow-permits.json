{
  "rules": [
    "PIP-9"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "The same request without the header, or with another value, is permitted: the DENY reads the header, not its absence.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        },
        {
          "id": "no-debug",
          "statements": [
            {
              "effect": "deny",
              "action": "http:GET",
              "condition": {
                "eq": [
                  "http.header.x-debug",
                  "1"
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        },
        {
          "id": "no-debug",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "no-debug"
        }
      ]
    }
  },
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "X-Debug": "0"
    }
  },
  "authentication": {
    "result": "authenticated"
  },
  "expect": {
    "status": 200,
    "proceed": true
  }
}
