{
  "rules": [
    "PIP-5"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "Some containers treat a backslash as a separator: 400.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "authentication": {
    "result": "anonymous"
  },
  "http": {
    "path": "/public/..%5Cadmin"
  },
  "expect": {
    "status": 400,
    "type": "invalid-request"
  }
}
