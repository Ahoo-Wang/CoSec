{
  "rules": [
    "PIP-10"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "alice is permitted on a route whose metadata says cosec-identity: false, and the client sends a CoSec-Identity of its own: the backend receives no identity at all. Through the gateway host's filters.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "open",
          "statements": [
            {
              "effect": "allow",
              "action": "http:GET"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "open",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "open"
        }
      ]
    }
  },
  "identity": {},
  "http": {
    "method": "GET",
    "path": "/orders",
    "headers": {
      "Authorization": "token",
      "CoSec-Identity": "eyJ2IjoxfQ"
    }
  },
  "authentication": {
    "result": "token",
    "token": {
      "jti": "t1",
      "tenant": "acme",
      "id": "alice",
      "roles": [
        "clerk"
      ]
    }
  },
  "expect": {
    "status": 200,
    "proceed": true,
    "identity": null
  },
  "gateway": {
    "route": {
      "identity": false
    }
  }
}
