{
  "rules": [
    "OBS-1"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "An ALLOW matches and the REQUIRED audit listener does not answer within its timeout: 503.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        }
      ]
    }
  },
  "listeners": [
    {
      "name": "audit",
      "delivery": "required",
      "hangs": true
    }
  ],
  "options": {
    "requiredTimeoutMillis": 50
  },
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
