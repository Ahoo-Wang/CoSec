{
  "rules": [
    "OBS-1"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "An ALLOW matches and the REQUIRED audit listener answers: the request proceeds.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "allow-all",
          "statements": [
            {
              "effect": "allow",
              "action": "*"
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "g:allow-all",
          "subject": "*",
          "app": "*",
          "space": "*",
          "policy": "allow-all"
        }
      ]
    }
  },
  "listeners": [
    {
      "name": "audit",
      "delivery": "required"
    }
  ],
  "expect": {
    "status": 200,
    "proceed": true
  }
}
