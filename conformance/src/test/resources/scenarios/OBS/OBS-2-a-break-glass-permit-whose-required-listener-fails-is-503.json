{
  "rules": [
    "OBS-2"
  ],
  "polarity": "positive",
  "level": "pipeline",
  "description": "The root break-glass binding permits, and the REQUIRED audit listener fails: 503.",
  "documents": {
    "platform": {
      "bindings": [
        {
          "id": "root",
          "subject": {
            "principal": "cosec",
            "tenant": "(platform)"
          },
          "app": "*",
          "space": "*",
          "policy": "cosec:root",
          "breakGlass": true,
          "expiresAt": "2099-12-31T00:00:00Z"
        }
      ]
    }
  },
  "authentication": {
    "tenant": "(platform)",
    "id": "cosec"
  },
  "listeners": [
    {
      "name": "audit",
      "delivery": "required",
      "fails": "audit store down"
    }
  ],
  "expect": {
    "status": 503,
    "type": "unavailable"
  }
}
