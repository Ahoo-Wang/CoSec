{
  "rules": [
    "BND-5"
  ],
  "polarity": "negative",
  "level": "engine",
  "description": "The binding gives editor the policy in team-a, where the principal is editor and asks.",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "edit",
            "statements": [
              {
                "effect": "allow",
                "action": "*"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "r:editor:edit",
            "subject": {
              "role": "editor"
            },
            "app": "*",
            "space": "team-a",
            "policy": "edit"
          }
        ]
      }
    }
  },
  "credential": {
    "roles": [
      "editor@team-a"
    ]
  },
  "request": {
    "space": "team-a"
  },
  "expect": {
    "decision": "Permit",
    "by": {
      "policy": "edit",
      "statement": 0,
      "via": {
        "binding": "r:editor:edit",
        "document": "tenant"
      }
    }
  }
}
