{
  "rules": [
    "APR-5"
  ],
  "polarity": "positive",
  "level": "control",
  "description": "Round-2 review R2: ada may approve only with level 3 and oncall true in her token, a number and a boolean; she approves walt's app change, and publishing checks her again with both, so it publishes.",
  "documents": {
    "platform": {
      "policies": [
        {
          "id": "writer",
          "statements": [
            {
              "effect": "allow",
              "action": [
                "cosec:read",
                "cosec:write",
                "cosec:grant",
                "cosec:publish"
              ],
              "resource": [
                "doc/**",
                "scope/**"
              ]
            }
          ]
        },
        {
          "id": "approver",
          "statements": [
            {
              "effect": "allow",
              "action": [
                "cosec:approve",
                "cosec:read"
              ],
              "resource": [
                "doc/**",
                "scope/**"
              ],
              "condition": {
                "and": [
                  {
                    "eq": [
                      "subject.attributes.level",
                      "3"
                    ]
                  },
                  {
                    "eq": [
                      "subject.attributes.oncall",
                      "true"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "bindings": [
        {
          "id": "plato",
          "subject": {
            "principal": "plato",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "cosec:platform-admin"
        },
        {
          "id": "walt",
          "subject": {
            "principal": "walt",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "writer"
        },
        {
          "id": "ada",
          "subject": {
            "principal": "ada",
            "tenant": "(platform)"
          },
          "app": "cosec-control",
          "space": "",
          "policy": "approver"
        }
      ]
    }
  },
  "operators": {
    "plato": {
      "tenant": "(platform)"
    },
    "walt": {
      "tenant": "(platform)"
    },
    "ada": {
      "tenant": "(platform)",
      "attributes": {
        "level": 3,
        "oncall": true,
        "teams": [
          "red",
          "blue"
        ]
      }
    }
  },
  "steps": [
    {
      "propose": {
        "change": "c1",
        "by": "walt",
        "document": "app:order",
        "operations": [
          {
            "putPolicy": {
              "id": "perm:order/read",
              "statements": [
                {
                  "effect": "allow",
                  "action": "order:read"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "stage": {
        "change": "c1",
        "by": "walt"
      }
    },
    {
      "shadowed": "c1"
    },
    {
      "approve": {
        "change": "c1",
        "by": "ada"
      }
    },
    {
      "publish": {
        "change": "c1",
        "by": "walt"
      }
    }
  ],
  "expect": {
    "steps": [
      "CHECKED",
      "SHADOWING",
      "AWAITING_APPROVAL",
      "READY",
      "PUBLISHED"
    ],
    "errors": {
      "c1": []
    },
    "heads": {
      "app:order": 1
    },
    "escalations": {
      "c1": [
        "NOT_ANALYZED"
      ]
    }
  }
}
