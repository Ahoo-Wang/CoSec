{
  "rules": [
    "ATR-6"
  ],
  "polarity": "negative",
  "level": "pipeline",
  "description": "A tenant document's DENY says onMissing nomatch without the control plane's confirmation: the document does not compile, as it would not in the platform document either (RFC 0007 N6).",
  "documents": {
    "tenants": {
      "acme": {
        "policies": [
          {
            "id": "deny-in-fence",
            "statements": [
              {
                "effect": "deny",
                "action": "*",
                "condition": {
                  "eq": [
                    "ext.geo.inFence",
                    true
                  ]
                },
                "onMissing": "nomatch"
              }
            ]
          }
        ],
        "bindings": [
          {
            "id": "g:deny-in-fence",
            "subject": "*",
            "app": "*",
            "space": "*",
            "policy": "deny-in-fence"
          }
        ]
      }
    }
  },
  "attributeProviders": [
    {
      "stage": "B",
      "declares": {
        "ext.geo.inFence": "bool"
      },
      "values": {
        "ext.geo.inFence": true
      }
    }
  ],
  "expect": {
    "decision": "NotCompiled",
    "error": "needs the control plane's confirmation"
  }
}
