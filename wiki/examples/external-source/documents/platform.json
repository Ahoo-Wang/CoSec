{
  "schema": 2,
  "revision": 1,
  "publishedAt": "2026-11-01T08:00:00Z",
  "policies": [
    {
      "id": "login",
      "statements": [
        {
          "name": "login",
          "effect": "allow",
          "action": "http:POST",
          "resource": "http:path:/auth/login"
        }
      ]
    },
    {
      "id": "control-api",
      "statements": [
        {
          "name": "reach-the-control-api",
          "effect": "allow",
          "action": [
            "http:GET",
            "http:POST",
            "http:DELETE"
          ],
          "resource": "http:path:/cosec/control/v1/**",
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    },
    {
      "id": "role-sync",
      "statements": [
        {
          "name": "project-tenant-roles",
          "effect": "allow",
          "action": [
            "cosec:read",
            "cosec:write",
            "cosec:skip-shadow",
            "cosec:publish",
            "cosec:manage-roles"
          ],
          "resource": [
            "doc/tenant/**"
          ]
        },
        {
          "name": "propose-the-catalog",
          "effect": "allow",
          "action": [
            "cosec:read",
            "cosec:write",
            "cosec:skip-shadow",
            "cosec:publish"
          ],
          "resource": [
            "doc/app/wms",
            "doc/app/wms/**"
          ]
        },
        {
          "name": "grant-in-its-scopes",
          "effect": "allow",
          "action": "cosec:grant",
          "resource": "scope/**"
        }
      ]
    }
  ],
  "bindings": [
    {
      "id": "login",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "login"
    },
    {
      "id": "control-api",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "control-api"
    },
    {
      "id": "role-sync",
      "subject": {
        "principal": "sync-service",
        "tenant": "(platform)"
      },
      "app": "cosec-control",
      "space": "",
      "policy": "role-sync"
    }
  ]
}
