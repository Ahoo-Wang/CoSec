{
  "schema": 2,
  "revision": 1,
  "publishedAt": "2026-11-01T08:00:00Z",
  "policies": [
    {
      "id": "control-api",
      "statements": [
        {
          "name": "reach-the-control-api",
          "effect": "allow",
          "action": [
            "http:GET",
            "http:POST",
            "http:DELETE"
          ],
          "resource": "http:path:/cosec/control/v1/**",
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    },
    {
      "id": "control-service",
      "statements": [
        {
          "name": "tenant-documents",
          "effect": "allow",
          "action": [
            "cosec:read",
            "cosec:shadow-read",
            "cosec:write",
            "cosec:publish",
            "cosec:skip-shadow"
          ],
          "resource": "doc/tenant/**"
        },
        {
          "name": "app-documents-to-read",
          "effect": "allow",
          "action": "cosec:read",
          "resource": "doc/app/**"
        },
        {
          "name": "bindings-in-tenants",
          "effect": "allow",
          "action": "cosec:grant",
          "resource": "scope/**"
        }
      ]
    },
    {
      "id": "control-reader",
      "statements": [
        {
          "name": "read-documents",
          "effect": "allow",
          "action": "cosec:read",
          "resource": [
            "doc/tenant/**",
            "doc/app/**"
          ]
        }
      ]
    }
  ],
  "bindings": [
    {
      "id": "control-api",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "control-api"
    },
    {
      "id": "svc-iam",
      "subject": {
        "principal": "svc-iam",
        "tenant": "(platform)"
      },
      "app": "cosec-control",
      "space": "",
      "policy": "control-service"
    },
    {
      "id": "svc-reports",
      "subject": {
        "principal": "svc-reports",
        "tenant": "(platform)"
      },
      "app": "cosec-control",
      "space": "",
      "policy": "control-reader"
    }
  ]
}
