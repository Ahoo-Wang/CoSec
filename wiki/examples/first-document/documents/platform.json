{
  "schema": 2,
  "revision": 1,
  "publishedAt": "2026-11-01T08:00:00Z",
  "policies": [
    {
      "id": "public",
      "statements": [
        {
          "name": "login",
          "effect": "allow",
          "action": "http:POST",
          "resource": "http:path:/auth/login"
        },
        {
          "name": "health",
          "effect": "allow",
          "action": "http:GET",
          "resource": "http:path:/actuator/health"
        }
      ]
    },
    {
      "id": "members",
      "statements": [
        {
          "name": "read-the-api",
          "effect": "allow",
          "action": "http:GET",
          "resource": "http:path:/api/**",
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    },
    {
      "id": "admins-only",
      "statements": [
        {
          "name": "admin-api-needs-the-admin-role",
          "effect": "deny",
          "action": "http:*",
          "resource": "http:path:/api/admin/**",
          "condition": {
            "not": {
              "in": [
                "admin",
                "scope.roles"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "control-api",
      "statements": [
        {
          "name": "reach-the-control-api",
          "effect": "allow",
          "action": [
            "http:GET",
            "http:POST",
            "http:DELETE"
          ],
          "resource": "http:path:/cosec/control/v1/**",
          "condition": {
            "eq": [
              "subject.authenticated",
              true
            ]
          }
        }
      ]
    }
  ],
  "bindings": [
    {
      "id": "public",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "public"
    },
    {
      "id": "members",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "members"
    },
    {
      "id": "admins-only",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "admins-only"
    },
    {
      "id": "control-api",
      "subject": "*",
      "app": "*",
      "space": "*",
      "policy": "control-api"
    }
  ]
}
